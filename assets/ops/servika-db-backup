#!/usr/bin/env bash
# Back up the Servika panel database for the daily timer and pre-update recovery.
# Authentication uses the root Unix socket. The completed dump path is written to stdout.
set -euo pipefail

# Parse in the C locale. Under tr_TR.UTF-8 the ranges `a-z` and `A-Z` do NOT
# contain `i` or `I`, so every character-range parse is cut at the first one
# (measured: `grep -oE '[a-zA-Z0-9_]+'` answers `aud` for `audit_log`). The
# brand name SERVIKA carries an I, so this reaches the environment loader too.
export LC_ALL=C

ENV_FILE=/etc/servika/env

load_servika_env() {
  [ -f "$ENV_FILE" ] || return 0
  [ "$(stat -c %u "$ENV_FILE" 2>/dev/null)" = 0 ] || { echo "insecure environment file owner" >&2; exit 1; }
  mode=$(stat -c %a "$ENV_FILE" 2>/dev/null) || { echo "could not read environment file mode" >&2; exit 1; }
  [ $((8#$mode & 077)) -eq 0 ] || { echo "insecure environment file mode" >&2; exit 1; }

  while IFS= read -r line || [ -n "$line" ]; do
    # POSIX classes, never `A-Za-z0-9`: a range is collation-ordered and under
    # tr_TR.UTF-8 it excludes `i`, which silently skipped SERVIKA_LISTEN.
    [[ "$line" =~ ^[[:space:]]*(SERVIKA_[[:alnum:]_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]%$'\r'}
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then value=${value:1:${#value}-2}; fi
    if [[ "$value" == \'*\' && "$value" == *\' ]]; then value=${value:1:${#value}-2}; fi
    if [ -z "${!key+x}" ]; then
      printf -v "$key" '%s' "$value"
      export "${key?}"
    fi
  done < "$ENV_FILE"
}

load_servika_env

# The off-site uploader lives in servika-offsite-lib so the panel dump and the
# host disaster-recovery archive share one copy of it. Sourcing is best-effort:
# this script runs under `set -e` and its stdout is the final-path contract, so a
# release where the library has not landed yet must still take the dump. That
# really happens: servika-update installs this tool before the ops loop, to take
# the pre-update dump.
servika_upload_offsite() { :; }
for offsite_lib in "${SERVIKA_OPSBIN:-/usr/local/bin}/servika-offsite-lib" /opt/servika/src/scripts/servika-offsite-lib; do
  if [ -r "$offsite_lib" ]; then
    # shellcheck source=/dev/null
    . "$offsite_lib" && break
  fi
done

BACKUP_DIR="${SERVIKA_DBDIR:-/var/backups/servika/db}"
case "$BACKUP_DIR" in
  /*) ;;
  *) echo "SERVIKA_DBDIR must be an absolute path: $BACKUP_DIR" >&2; exit 1 ;;
esac
RETENTION_DAYS=14
# The ROOT is secured before the leaf, because `mkdir -p` creates every missing
# component with the umask and the chmod below reaches only the last one. On a
# stock server (umask 022) that left /var/backups/servika at 0755 while its
# children were 0700, and the panel writes one child per tenant named after that
# tenant's system user. Measured on AlmaLinux 9: a `c_*` account listing the root
# read every other tenant's system user name, though not the archives inside.
# 0700 root:root is right because nothing but root ever reads any of it (the
# panel runs as root and this script's unit declares no User=).
install -d -m 0700 "${SERVIKA_BACKUP_ROOT:-/var/backups/servika}" \
  || echo "warning: the backup root could not be secured" >&2
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

timestamp=$(date +%F-%H%M%S)
temporary="$BACKUP_DIR/.panel-$timestamp.sql.gz.tmp"
final="$BACKUP_DIR/panel-$timestamp.sql.gz"
trap 'rm -f "$temporary"' EXIT

# Create a consistent InnoDB snapshot including stored database objects.
mysqldump --single-transaction --routines --triggers --events \
  --databases panel | gzip -c > "$temporary"

# Publish only complete, valid dumps.
gzip -t "$temporary"
[ "$(stat -c%s "$temporary")" -gt 1000 ] || {
  rm -f "$temporary"
  echo "database dump is suspiciously small" >&2
  exit 1
}

mv -f "$temporary" "$final"
chmod 600 "$final"

# Retain only this tool's panel database dumps and remove abandoned temporary files.
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'panel-*.sql.gz' \
  -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_DIR" -maxdepth 1 -type f -name '.panel-*.sql.gz.tmp' \
  -mtime +1 -delete

# Best-effort secondary copy to an offsite destination (no-op unless configured).
servika_upload_offsite DB "$final" 'panel-*.sql.gz' servika-db 14

echo "$final"
