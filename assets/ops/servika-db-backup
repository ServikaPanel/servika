#!/usr/bin/env bash
# Back up the Servika panel database for the daily timer and pre-update recovery.
# Authentication uses the root Unix socket. The completed dump path is written to stdout.
set -euo pipefail

# Parse in the C locale. Under tr_TR.UTF-8 the ranges `a-z` and `A-Z` do NOT
# contain `i` or `I`, so every character-range parse is cut at the first one
# (measured: `grep -oE '[a-zA-Z0-9_]+'` answers `aud` for `audit_log`). The
# brand name SERVIKA carries an I, so this reaches the environment loader too.
export LC_ALL=C

ENV_FILE=/etc/servika/env

load_servika_env() {
  [ -f "$ENV_FILE" ] || return 0
  [ "$(stat -c %u "$ENV_FILE" 2>/dev/null)" = 0 ] || { echo "insecure environment file owner" >&2; exit 1; }
  mode=$(stat -c %a "$ENV_FILE" 2>/dev/null) || { echo "could not read environment file mode" >&2; exit 1; }
  [ $((8#$mode & 077)) -eq 0 ] || { echo "insecure environment file mode" >&2; exit 1; }

  while IFS= read -r line || [ -n "$line" ]; do
    # POSIX classes, never `A-Za-z0-9`: a range is collation-ordered and under
    # tr_TR.UTF-8 it excludes `i`, which silently skipped SERVIKA_LISTEN.
    [[ "$line" =~ ^[[:space:]]*(SERVIKA_[[:alnum:]_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]%$'\r'}
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then value=${value:1:${#value}-2}; fi
    if [[ "$value" == \'*\' && "$value" == *\' ]]; then value=${value:1:${#value}-2}; fi
    if [ -z "${!key+x}" ]; then
      printf -v "$key" '%s' "$value"
      export "${key?}"
    fi
  done < "$ENV_FILE"
}

load_servika_env

# lftp_escape: escape a value placed inside double quotes on the lftp command line
# (mirrors internal/backups/destination.go lftpEscape).
lftp_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

# upload_offsite: best-effort secondary copy of the just-published dump to an
# FTP/SFTP destination configured through /etc/servika/env. A failure here never
# fails the backup: the local dump is already valid, and servika-update/-restore
# depend on this script succeeding to take a pre-update dump. Diagnostics go to
# stderr so the stdout final-path contract stays intact.
upload_offsite() {
  local dump=$1 name
  name=$(basename "$dump")
  local otype="${SERVIKA_DB_OFFSITE_TYPE:-}"
  [ -n "$otype" ] || return 0 # offsite not configured
  if [ "$otype" != "ftp" ] && [ "$otype" != "sftp" ]; then
    echo "offsite: invalid SERVIKA_DB_OFFSITE_TYPE (want ftp|sftp), skipping upload" >&2
    return 0
  fi
  local host="${SERVIKA_DB_OFFSITE_HOST:-}"
  if [ -z "$host" ]; then
    echo "offsite: SERVIKA_DB_OFFSITE_HOST is empty, skipping upload" >&2
    return 0
  fi
  # Reject hosts carrying lftp/shell metacharacters before embedding in the command line.
  case "$host" in
    *[\"\\\ \;\`\$\'*?\<\>\|]*|*'&'*)
      echo "offsite: SERVIKA_DB_OFFSITE_HOST contains invalid characters, skipping upload" >&2
      return 0 ;;
  esac
  local port="${SERVIKA_DB_OFFSITE_PORT:-}"
  if [ -z "$port" ]; then
    if [ "$otype" = "sftp" ]; then port=22; else port=21; fi
  fi
  case "$port" in
    ''|*[!0-9]*) echo "offsite: SERVIKA_DB_OFFSITE_PORT must be numeric, skipping upload" >&2; return 0 ;;
  esac
  local dir="${SERVIKA_DB_OFFSITE_DIR:-servika-db}"
  local user="${SERVIKA_DB_OFFSITE_USER:-}"
  local pass="${SERVIKA_DB_OFFSITE_PASS:-}"
  local keep="${SERVIKA_DB_OFFSITE_KEEP:-14}"
  case "$keep" in
    ''|*[!0-9]*) keep=14 ;;
  esac
  if ! command -v lftp >/dev/null 2>&1; then
    echo "offsite: lftp not found on PATH, skipping upload" >&2
    return 0
  fi
  local eu ep ed
  eu=$(lftp_escape "$user"); ep=$(lftp_escape "$pass"); ed=$(lftp_escape "$dir")
  # Upload the new dump, then keep only the newest $keep panel-*.sql.gz remotely.
  local script
  script=$(printf 'set cmd:fail-exit yes; set sftp:auto-confirm yes; set ssl:verify-certificate no; set ftp:ssl-allow no; set net:max-retries 1; set net:timeout 15; open -u "%s","%s" %s://%s:%s; mkdir -p -f "%s"; cd "%s"; put -O . "%s"; bye' \
    "$eu" "$ep" "$otype" "$host" "$port" "$ed" "$ed" "$dump")
  if ! lftp -c "$script" >/dev/null 2>&1; then
    echo "offsite: upload of $name to $otype://$host:$port failed" >&2
    return 0
  fi
  # Remote retention: list newest-first, delete entries beyond $keep. Best-effort.
  local prune
  prune=$(printf 'set cmd:fail-exit no; set sftp:auto-confirm yes; set ssl:verify-certificate no; set ftp:ssl-allow no; set net:max-retries 1; set net:timeout 15; open -u "%s","%s" %s://%s:%s; cd "%s"; cls -1 --sort=date -r panel-*.sql.gz; bye' \
    "$eu" "$ep" "$otype" "$host" "$port" "$ed")
  local listing
  if listing=$(lftp -c "$prune" 2>/dev/null); then
    local old
    old=$(printf '%s\n' "$listing" | grep -E '^panel-.*\.sql\.gz$' | tail -n +$((keep + 1)))
    if [ -n "$old" ]; then
      local rm_script line
      rm_script=$(printf 'set cmd:fail-exit no; set sftp:auto-confirm yes; set ssl:verify-certificate no; set ftp:ssl-allow no; set net:max-retries 1; set net:timeout 15; open -u "%s","%s" %s://%s:%s; cd "%s";' \
        "$eu" "$ep" "$otype" "$host" "$port" "$ed")
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        rm_script+=$(printf ' rm -f "%s";' "$(lftp_escape "$line")")
      done <<< "$old"
      rm_script+=' bye'
      lftp -c "$rm_script" >/dev/null 2>&1 || true
    fi
  fi
  echo "offsite: uploaded $name to $otype://$host:$port/$dir" >&2
}

BACKUP_DIR="${SERVIKA_DBDIR:-/var/backups/servika/db}"
case "$BACKUP_DIR" in
  /*) ;;
  *) echo "SERVIKA_DBDIR must be an absolute path: $BACKUP_DIR" >&2; exit 1 ;;
esac
RETENTION_DAYS=14
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

timestamp=$(date +%F-%H%M%S)
temporary="$BACKUP_DIR/.panel-$timestamp.sql.gz.tmp"
final="$BACKUP_DIR/panel-$timestamp.sql.gz"
trap 'rm -f "$temporary"' EXIT

# Create a consistent InnoDB snapshot including stored database objects.
mysqldump --single-transaction --routines --triggers --events \
  --databases panel | gzip -c > "$temporary"

# Publish only complete, valid dumps.
gzip -t "$temporary"
[ "$(stat -c%s "$temporary")" -gt 1000 ] || {
  rm -f "$temporary"
  echo "database dump is suspiciously small" >&2
  exit 1
}

mv -f "$temporary" "$final"
chmod 600 "$final"

# Retain only this tool's panel database dumps and remove abandoned temporary files.
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'panel-*.sql.gz' \
  -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_DIR" -maxdepth 1 -type f -name '.panel-*.sql.gz.tmp' \
  -mtime +1 -delete

# Best-effort secondary copy to an offsite destination (no-op unless configured).
upload_offsite "$final"

echo "$final"
