#!/usr/bin/env bash
# servika-update safely updates an installed Servika instance from GitHub.
#
#   servika-update            # Fetch the latest release, replace assets, and restart
#   servika-update --dry-run  # Show changes without applying them
#   servika-update --force    # Apply the update even when the binary is unchanged
#   servika-update --branch X # Update from another branch (default: main)
#
# This command preserves /etc/servika/env, the MariaDB panel database, and /home/c_* sites.
# Before migrations run, it creates a full panel database dump. A failed dump stops the update.
# If the new release fails its health check, the previous binary and database are restored.
set -euo pipefail

# sudo builds PATH from scratch out of secure_path, which on AlmaLinux 10 is
# /sbin:/bin:/usr/sbin:/usr/bin and excludes /usr/local/bin, where this tool and
# its siblings live. Without this the `command -v servika-*` guards below report
# an installed tool as absent and skip the step while the run still reports
# success.
case ":$PATH:" in
  *:/usr/local/bin:*) : ;;
  *) export PATH="/usr/local/sbin:/usr/local/bin:$PATH" ;;
esac

# Parse in the C locale. Under tr_TR.UTF-8 the ranges `a-z` and `A-Z` do NOT
# contain `i` or `I`, so every character-range parse is cut at the first one
# (measured: `grep -oE '[a-zA-Z0-9_]+'` answers `aud` for `audit_log`). The
# brand name SERVIKA carries an I, so this reaches the environment loader too:
# without this the loader skipped SERVIKA_LISTEN, the health URL could not be
# derived, and this tool refused to run at all on a Turkish-locale host.
export LC_ALL=C

ENV_FILE=/etc/servika/env

load_servika_env() {
  [ -f "$ENV_FILE" ] || return 0
  [ "$(stat -c %u "$ENV_FILE" 2>/dev/null)" = 0 ] || { echo "insecure environment file owner" >&2; exit 1; }
  mode=$(stat -c %a "$ENV_FILE" 2>/dev/null) || { echo "could not read environment file mode" >&2; exit 1; }
  [ $((8#$mode & 077)) -eq 0 ] || { echo "insecure environment file mode" >&2; exit 1; }

  while IFS= read -r line || [ -n "$line" ]; do
    # POSIX classes, never `A-Za-z0-9`: a range is collation-ordered and under
    # tr_TR.UTF-8 it excludes `i`, which silently skipped SERVIKA_LISTEN.
    [[ "$line" =~ ^[[:space:]]*(SERVIKA_[[:alnum:]_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]%$'\r'}
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then value=${value:1:${#value}-2}; fi
    if [[ "$value" == \'*\' && "$value" == *\' ]]; then value=${value:1:${#value}-2}; fi
    if [ -z "${!key+x}" ]; then
      printf -v "$key" '%s' "$value"
      export "${key?}"
    fi
  done < "$ENV_FILE"
}

load_servika_env

# The health check URL is DERIVED from SERVIKA_LISTEN, the one setting that says
# where the backend listens. It used to be a setting of its own with the port
# written into it, and the panel can MOVE its backend port, which never touched
# that copy: this tool then health-checked a port nothing answers on, concluded
# the new release was broken, and restored the previous binary, every release
# asset and the pre-update database dump. A healthy update rolled itself back on
# every attempt. Derived, there is nothing left to keep in sync.
#
# The derivation is done here rather than by asking servika-server, because
# servika-restore carries the same code and exists precisely for a binary that
# cannot run.
#
# A listen address may name no host (":8080") or a wildcard, and none of those
# can be dialled, so they all collapse to loopback, where the panel answers in
# every one of them. internal/panelport.HealthURL carries the same rule.
derive_health_url() {
  local listen="${SERVIKA_LISTEN:-}" host port
  listen=${listen%\"}; listen=${listen#\"}
  listen=${listen%\'}; listen=${listen#\'}
  case "$listen" in
    *:*) ;;
    *) echo "SERVIKA_LISTEN ($listen) names no port, so the health check URL cannot be derived; set SERVIKA_HEALTH" >&2; return 1 ;;
  esac
  port=${listen##*:}
  host=${listen%:*}
  case "$port" in
    ''|*[!0-9]*) echo "SERVIKA_LISTEN ($listen) names no port, so the health check URL cannot be derived; set SERVIKA_HEALTH" >&2; return 1 ;;
  esac
  host=${host#[}; host=${host%]}
  case "$host" in
    ''|0.0.0.0|::|'*') host=127.0.0.1 ;;
  esac
  case "$host" in
    *:*) host="[$host]" ;;
  esac
  printf 'http://%s:%s/healthz\n' "$host" "$port"
}

REPO="${SERVIKA_REPO:-ServikaPanel/servika}"
BRANCH="main"; DRY=0; FORCE=0; BRANCH_EXPLICIT=0
PREFIX="${SERVIKA_PREFIX:-/opt/servika}"
BIN="${SERVIKA_BIN:-$PREFIX/bin/servika-server}"
SEED="${SERVIKA_SEED:-$PREFIX/bin/servika-seed-admin}"
FDIST="${SERVIKA_FDIST:-$PREFIX/frontend-dist}"
MIGR="${SERVIKA_MIGR:-$PREFIX/src/migrations}"
SCRIPTS="${SERVIKA_SCRIPTS:-$PREFIX/src/scripts}"
OPSBIN="${SERVIKA_OPSBIN:-/usr/local/bin}"
SVC="${SERVIKA_SVC:-servika}"
HEALTH="${SERVIKA_HEALTH:-}"
if [ -z "$HEALTH" ]; then
  # An empty result is left empty on purpose: validate_paths below refuses it by
  # name rather than this guessing a port and reporting a dead one as healthy.
  HEALTH=$(derive_health_url) || HEALTH=""
fi
DB_BACKUP="${SERVIKA_DBBK:-$OPSBIN/servika-db-backup}"
DB_BACKUP_DIR="${SERVIKA_DBDIR:-/var/backups/servika/db}"
# Durable home for the panel vhost this update replaces. The rollback snapshot is
# discarded once the update succeeds, so operator edits need somewhere that
# outlives it. The file carries the X-Servika-Proxy secret, hence 0700/0600.
VHOST_KEEP_DIR="${SERVIKA_VHOSTDIR:-/var/backups/servika/nginx}"
VHOST_KEEP_MAX=5
PRE_UPDATE_DUMP=""

# Detect host architecture for binary selection.
MACHINE=$(uname -m)
case "$MACHINE" in
  x86_64)  ARCH=linux_amd64 ;;
  aarch64) ARCH=linux_arm64 ;;
  *)       die "unsupported architecture: $MACHINE (expected x86_64 or aarch64)" ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --force) FORCE=1 ;;
    --branch) BRANCH="$2"; BRANCH_EXPLICIT=1; shift ;;
    --branch=*) BRANCH="${1#*=}"; BRANCH_EXPLICIT=1 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

c_b="\033[1;34m"; c_g="\033[32m"; c_r="\033[31m"; c_y="\033[33m"; c_0="\033[0m"
[ -t 1 ] || { c_b=; c_g=; c_r=; c_y=; c_0=; }
ok()   { echo -e "  ${c_g}✓${c_0} $*"; }
warn() { echo -e "  ${c_y}!${c_0} $*"; }
die()  { echo -e "${c_r}✗ $*${c_0}" >&2; exit 1; }
step() { echo -e "${c_b}══ $* ══${c_0}"; }

# resolve_release_tag prints the release tag to deploy, or nothing if none can be
# determined. SERVIKA_RELEASE_TAG pins an exact release; otherwise the latest
# published GitHub release is queried. Mirrors install.sh so update deploys the
# same immutable, reviewed artifact the installer does.
resolve_release_tag() {
  local tag="${SERVIKA_RELEASE_TAG:-}"
  if [ -z "$tag" ]; then
    tag=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null \
      | grep '"tag_name"' | head -1 | cut -d'"' -f4)
  fi
  printf '%s' "$tag"
}

# verify_release_bundle <bundle> <sums_file> <bundle_name> confirms the bundle's
# sha256 matches the entry in the release SHA256SUMS. Returns non-zero on a
# missing/malformed checksum or a mismatch so callers can fall back safely.
verify_release_bundle() {
  local bundle_path="$1" sums_path="$2" bundle_name="$3" expected actual
  expected=$(awk -v name="$bundle_name" '$2 == name {print $1; exit}' "$sums_path")
  printf '%s' "$expected" | grep -Eq '^[0-9a-fA-F]{64}$' || return 1
  actual=$(sha256sum "$bundle_path" | cut -d' ' -f1)
  [ "$actual" = "$expected" ]
}

# restore_release_assets undoes every pre-restart asset swap from snapshots taken
# during this run. Each step is existence-guarded and best-effort so a missing
# snapshot for one asset never blocks the restore of the others. Called only on
# the rollback path, before the previous binary is restarted.
restore_release_assets() {
  # Frontend: reuse the atomic ${FDIST}.old kept by the verified swap.
  if [ -d "${FDIST}.old" ]; then
    rm -rf "${FDIST}.new-failed" 2>/dev/null || true
    [ -d "$FDIST" ] && mv "$FDIST" "${FDIST}.new-failed" 2>/dev/null || true
    mv "${FDIST}.old" "$FDIST" 2>/dev/null || true
    rm -rf "${FDIST}.new-failed" 2>/dev/null || true
    command -v restorecon >/dev/null && restorecon -R "$FDIST" >/dev/null 2>&1 || true
    ok "frontend restored to previous release"
  fi
  # Migrations: replace the on-disk set with the snapshot so the old binary does
  # not re-run new migrations against the restored (older) schema.
  if [ -d "$ROLLBACK_DIR/migrations" ]; then
    if rm -rf "$MIGR" 2>/dev/null && cp -a "$ROLLBACK_DIR/migrations" "$MIGR" 2>/dev/null; then
      ok "migrations restored to previous release"
    else
      warn "migrations restore incomplete"
    fi
  fi
  # Mail templates.
  if [ -d "$ROLLBACK_DIR/mail-templates" ]; then
    MAIL_TMPL="$PREFIX/src/mail-templates"
    rm -rf "$MAIL_TMPL" 2>/dev/null && cp -a "$ROLLBACK_DIR/mail-templates" "$MAIL_TMPL" 2>/dev/null || true
  fi
  # Config files.
  [ -f "$ROLLBACK_DIR/_panel.conf" ] && cp -a "$ROLLBACK_DIR/_panel.conf" /etc/nginx/conf.d/_panel.conf 2>/dev/null || true
  [ -f "$ROLLBACK_DIR/roundcube.conf" ] && cp -a "$ROLLBACK_DIR/roundcube.conf" /etc/php-fpm.d/roundcube.conf 2>/dev/null || true
  # Ops tools + scripts.
  if [ -d "$ROLLBACK_DIR/opsbin" ]; then
    for t in "$ROLLBACK_DIR"/opsbin/*; do
      [ -f "$t" ] && install -m 0755 "$t" "$OPSBIN/$(basename "$t")" 2>/dev/null || true
    done
  fi
  if [ -d "$ROLLBACK_DIR/scripts" ]; then
    rm -rf "$SCRIPTS" 2>/dev/null && cp -a "$ROLLBACK_DIR/scripts" "$SCRIPTS" 2>/dev/null || true
  fi
  ok "release-owned assets restored to previous version"
}

require_abs_path() {
  local name="$1"
  local value="$2"
  [ -n "$value" ] || die "$name must not be empty"
  case "$value" in
    /*) ;;
    *) die "$name must be an absolute path: $value" ;;
  esac
}

require_url() {
  local name="$1"
  local value="$2"
  case "$value" in
    http://*|https://*) ;;
    *) die "$name must be an http or https URL: $value" ;;
  esac
}

validate_paths() {
  require_abs_path SERVIKA_PREFIX "$PREFIX"
  require_abs_path SERVIKA_BIN "$BIN"
  require_abs_path SERVIKA_SEED "$SEED"
  require_abs_path SERVIKA_FDIST "$FDIST"
  require_abs_path SERVIKA_MIGR "$MIGR"
  require_abs_path SERVIKA_SCRIPTS "$SCRIPTS"
  require_abs_path SERVIKA_OPSBIN "$OPSBIN"
  require_abs_path SERVIKA_DBBK "$DB_BACKUP"
  require_abs_path SERVIKA_DBDIR "$DB_BACKUP_DIR"
  require_abs_path SERVIKA_VHOSTDIR "$VHOST_KEEP_DIR"
  require_url SERVIKA_HEALTH "$HEALTH"
}

validate_paths

version() { curl -fsS "$HEALTH" 2>/dev/null | grep -oE '"version":"[^"]*"' | cut -d'"' -f4; }

[ "$(id -u)" = 0 ] || die "root is required (sudo servika-update)"
[ -x "$BIN" ] || die "Servika is not installed ($BIN is missing); run install.sh first"
command -v curl >/dev/null || die "curl is required"
command -v tar  >/dev/null || die "tar is required"
command -v sha256sum >/dev/null || die "sha256sum is required"

# Rollback staging: snapshots of every release-owned asset are taken here just
# before each pre-restart swap, so a failed health check can restore the complete
# previous release, not only the binary and database.
ROLLBACK_DIR="$PREFIX/.update-rollback.$$"
TMP=$(mktemp -d); trap 'rm -rf "$TMP" "$ROLLBACK_DIR"' EXIT
mkdir -p "$ROLLBACK_DIR"

# Source resolution: prefer the immutable tagged release bundle (same artifact as
# install.sh). An explicit --branch opts into the mutable branch tarball; a failed
# tag resolution or bundle download falls back to it with a warning. A bundle that
# fails its checksum does NOT: that is a fatal error, never a reason to reach for
# a source with no checksum.
A=""
if [ "$BRANCH_EXPLICIT" = 0 ]; then
  TAG=$(resolve_release_tag)
  if [ -n "$TAG" ]; then
    VERSION_TAG="${TAG#v}"
    BUNDLE="servika-${VERSION_TAG}-${ARCH}.tar.gz"
    BUNDLE_URL="https://github.com/$REPO/releases/download/$TAG/$BUNDLE"
    SUMS_URL="https://github.com/$REPO/releases/download/$TAG/SHA256SUMS"
    step "Servika update (release $TAG, $ARCH)"
    echo "  downloading release bundle..."
    # A download that does not arrive and a bundle that does not match its
    # checksum are NOT the same event, so they must not share an outcome.
    #
    # Not arriving is a network problem, and falling back to the branch tarball
    # is a reasonable answer to it. Not matching is evidence that the bundle is
    # not the one the release published. Falling back there would mean anyone
    # able to serve a wrong bundle only has to make the checksum fail to move
    # this script onto a source with no checksum at all, which it then installs
    # from as root. install.sh has always treated a mismatch as fatal; this is
    # the same rule in the two places that update an installed host.
    if ! curl -fsSL --retry 3 -o "$TMP/$BUNDLE" "$BUNDLE_URL" \
       || ! curl -fsSL --retry 3 -o "$TMP/SHA256SUMS" "$SUMS_URL"; then
      warn "release bundle download failed ($BUNDLE_URL); falling back to branch '$BRANCH'"
      rm -rf "${TMP:?}/"* 2>/dev/null || true
    elif ! verify_release_bundle "$TMP/$BUNDLE" "$TMP/SHA256SUMS" "$BUNDLE"; then
      die "checksum mismatch for $BUNDLE against the $TAG release SHA256SUMS; refusing to continue. Re-run with --branch $BRANCH only if you accept an unverified source."
    elif ! tar xz -C "$TMP" -f "$TMP/$BUNDLE"; then
      # The checksum already passed, so this is a local unpack problem rather
      # than a bad artifact: the branch tarball is a fair second attempt.
      warn "the verified bundle could not be unpacked; falling back to branch '$BRANCH'"
      rm -rf "${TMP:?}/"* 2>/dev/null || true
    else
      ok "checksum verified"
      A="$TMP/assets"
    fi
  else
    warn "could not resolve a release tag; falling back to branch '$BRANCH'"
  fi
fi
if [ -z "$A" ]; then
  step "Servika update (github.com/$REPO@$BRANCH)"
  echo "  downloading..."
  curl -fsSL "https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH" | tar xz -C "$TMP" \
    || die "download failed; verify that the repository is public and branch '$BRANCH' exists"
  SRC=$(find "$TMP" -maxdepth 1 -type d -name "*-$BRANCH" | head -1)
  A="$SRC/assets"
fi
NEWBIN="$A/$ARCH/servika-server"
[ -f "$NEWBIN" ] || die "$A/$ARCH/servika-server is missing"

# Validate the binary without executing it, then hash every release component so updates to
# frontend, migrations, operations tools, or systemd units are not skipped.
head -c4 "$NEWBIN" | grep -q $'\x7fELF' || die "the downloaded binary is not a valid ELF file"
# Cross-arch guard: prevent deploying an amd64 binary onto an arm64 host (or vice versa).
command -v file >/dev/null 2>&1 && file "$NEWBIN" | grep -q "$MACHINE" || die "the downloaded binary does not match the host architecture ($MACHINE)"
CURVER=$(version); [ -n "$CURVER" ] || CURVER="?"
echo "  current version: $CURVER"
RELHASH=$( { sha256sum "$NEWBIN" | cut -d' ' -f1
  [ -f "$A/frontend-dist.tar.gz" ] && sha256sum "$A/frontend-dist.tar.gz" | cut -d' ' -f1
  [ -f "$A/migrations.tar.gz" ] && sha256sum "$A/migrations.tar.gz" | cut -d' ' -f1
  find "$A/ops" "$A/systemd" "$A/mail" "$A/php-fpm" "$A/nginx" -type f 2>/dev/null | LC_ALL=C sort \
    | xargs -r sha256sum 2>/dev/null | cut -d' ' -f1
  true; } | sha256sum | cut -d' ' -f1)
MARKER="$PREFIX/.release_hash"
CURREL=$(cat "$MARKER" 2>/dev/null || echo missing)
if [ "$RELHASH" = "$CURREL" ] && [ "$FORCE" = 0 ]; then
  ok "the complete release is already current; use --force to reapply"
  exit 0
fi

if [ "$DRY" = 1 ]; then
  step "DRY RUN"
  echo "  • $BIN (replace if changed; backup: $BIN.bak)"
  echo "  • $FDIST/"
  echo "  • $MIGR/"
  echo "  • $OPSBIN operations tools and $SCRIPTS"
  echo "  • servika-repair --only htpasswd,clamav,frontend,signon (+mail when configured)"
  echo "  • mail templates under $PREFIX/src/mail-templates"
  echo "  • nginx and PHP-FPM panel integration files"
  echo "  • the replaced panel vhost kept under $VHOST_KEEP_DIR (last $VHOST_KEEP_MAX)"
  echo "  • $DB_BACKUP and /etc/systemd/system/servika-db-backup.{service,timer}"
  echo "  • full panel database dump before migrations: $DB_BACKUP_DIR (not created during dry run)"
  echo "  • systemctl restart servika"
  exit 0
fi

# Install the backup tool and timer before taking the mandatory pre-update dump.
[ -f "$A/ops/servika-db-backup" ] \
  || die "the release does not contain the database backup tool; update was not started"
install -m 0755 "$A/ops/servika-db-backup" "$DB_BACKUP"
UNITS_INSTALLED=0
for unit in servika-db-backup.service servika-db-backup.timer; do
  if [ -f "$A/systemd/$unit" ]; then
    install -m 0644 "$A/systemd/$unit" "/etc/systemd/system/$unit"
    UNITS_INSTALLED=1
  fi
done
if [ "$UNITS_INSTALLED" = 1 ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now servika-db-backup.timer >/dev/null 2>&1 || true
  if systemctl is-active --quiet servika-db-backup.timer; then
    ok "daily panel database backup timer active"
  else
    warn "database backup timer could not be started"
  fi
fi

# Refuse to expose migrations unless a complete recovery point exists.
step "Pre-update database backup"
[ -x "$DB_BACKUP" ] || die "database backup tool is unavailable; update was not started"
PRE_UPDATE_DUMP=$("$DB_BACKUP") \
  || die "pre-update database backup failed; update was not started"
[ -n "$PRE_UPDATE_DUMP" ] && [ -f "$PRE_UPDATE_DUMP" ] \
  || die "pre-update database backup could not be verified; update was not started"
ok "pre-update database dump: $PRE_UPDATE_DUMP"

cp -f "$BIN" "$BIN.bak"
[ -x "$SEED" ] && cp -f "$SEED" "$SEED.bak" 2>/dev/null || true
ok "current binary backed up"

install -m 0755 "$NEWBIN" "$BIN"
[ -f "$A/$ARCH/servika-seed-admin" ] && install -m 0755 "$A/$ARCH/servika-seed-admin" "$SEED"
ok "binary updated"

# 7) frontend-dist — ATOMIC + VERIFIED swap.
# The old pattern `rm -rf "${FDIST:?}/"* && tar xzf ...` DELETED the running frontend FIRST,
# so an interrupted extraction or a reboot before flush meant 0-byte files → WHITE SCREEN
# outage with no rollback. Now the new version is extracted to a separate temp directory,
# its integrity is VERIFIED, and only then it is atomically swapped in with mv. A
# corrupted or truncated extraction NEVER touches the running frontend.
if [ -f "$A/frontend-dist.tar.gz" ]; then
  FDNEW="${FDIST}.new.$$"
  # On extraction failure: clean up the temp directory + roll back the binary (already
  # swapped in step 6) to the backup so a failed update is a complete no-op on disk.
  # The service has NOT been restarted yet (restart is step 11) — the running panel
  # keeps serving the old binary + old frontend without interruption.
  fdist_abort() {
    rm -rf "$FDNEW" 2>/dev/null || true
    install -m 0755 "$BIN.bak" "$BIN" 2>/dev/null || true
    [ -f "$SEED.bak" ] && install -m 0755 "$SEED.bak" "$SEED" 2>/dev/null || true
    command -v restorecon >/dev/null && restorecon "$BIN" >/dev/null 2>&1 || true
    die "$1"
  }
  rm -rf "$FDNEW"; mkdir -p "$FDNEW"
  if ! tar xzf "$A/frontend-dist.tar.gz" -C "$FDNEW"; then
    fdist_abort "frontend-dist extraction failed — running frontend + previous binary PRESERVED"
  fi
  # Integrity gate: index.html must be non-empty + at least one JS bundle must exist
  # (0-byte or truncated tarballs are rejected).
  if [ ! -s "$FDNEW/index.html" ] || ! ls "$FDNEW"/assets/index-*.js >/dev/null 2>&1; then
    fdist_abort "frontend-dist corrupt (index.html or JS bundles empty or missing) — running frontend + previous binary PRESERVED"
  fi
  rm -rf "${FDIST}.old"
  [ -d "$FDIST" ] && mv "$FDIST" "${FDIST}.old"
  mv "$FDNEW" "$FDIST"
  sync   # reboot-safe: flush to disk to prevent delayed-allocation data loss
  ok "frontend updated (atomic verified swap)"
fi

if [ -f "$A/migrations.tar.gz" ]; then
  # Snapshot the current migrations so a rollback removes any file the failed
  # release added; otherwise the restored old binary would re-run new migrations
  # against the restored (older) schema.
  [ -d "$MIGR" ] && cp -a "$MIGR" "$ROLLBACK_DIR/migrations" 2>/dev/null || true
  # The one unguarded critical command in this script. Under `set -e` a failed
  # tar aborts here with NO red line, so `die` never runs, the health check and
  # the rollback block below never run either, and the new binary and frontend
  # are left on disk beside an incomplete migration set. The panel then starts
  # against a schema it does not match, at the next restart or reboot.
  mkdir -p "$MIGR" || die "the migrations directory could not be created"
  tar xzf "$A/migrations.tar.gz" -C "$MIGR" \
    || die "the migrations archive could not be extracted; the previous binary is at $BIN.bak"
  ok "migrations synchronized ($(ls "$MIGR"/*.sql 2>/dev/null | wc -l) SQL files)"
fi

if [ -d "$A/mail" ]; then
  MAIL_TMPL="$PREFIX/src/mail-templates"
  [ -d "$MAIL_TMPL" ] && cp -a "$MAIL_TMPL" "$ROLLBACK_DIR/mail-templates" 2>/dev/null || true
  mkdir -p "$MAIL_TMPL"
  rm -rf "${MAIL_TMPL:?}/"*
  cp -a "$A/mail/." "$MAIL_TMPL/"
  ok "mail templates updated"
fi
if [ -f "$A/nginx/_panel.conf" ]; then
  [ -f /etc/nginx/conf.d/_panel.conf ] && cp -a /etc/nginx/conf.d/_panel.conf "$ROLLBACK_DIR/_panel.conf" 2>/dev/null || true

  # The replacement is unconditional, so any hand edit in the installed file is
  # gone the moment the rollback snapshot is discarded. Keep the outgoing copy
  # somewhere durable, root-only because it carries the X-Servika-Proxy secret,
  # and prune to the last few so the directory cannot grow without bound.
  KEPT_VHOST=""
  if [ -f /etc/nginx/conf.d/_panel.conf ]; then
    if mkdir -p "$VHOST_KEEP_DIR" && chmod 700 "$VHOST_KEEP_DIR"; then
      KEPT_VHOST="$VHOST_KEEP_DIR/_panel.conf.$(date +%Y%m%d-%H%M%S)"
      if cp -a /etc/nginx/conf.d/_panel.conf "$KEPT_VHOST" && chmod 600 "$KEPT_VHOST"; then
        # shellcheck disable=SC2012 # names are generated above and contain no newlines
        ls -1t "$VHOST_KEEP_DIR"/_panel.conf.* 2>/dev/null | tail -n +$((VHOST_KEEP_MAX + 1)) \
          | while read -r old; do rm -f "$old"; done
      else
        KEPT_VHOST=""
        warn "could not keep a copy of the current panel vhost"
      fi
    fi
  fi

  # Only attribute a syntax failure to this copy when the configuration was sound
  # beforehand; a host already failing nginx -t is broken for another reason and
  # reverting would hide that instead of fixing it.
  NGINX_WAS_OK=0
  nginx -t >/dev/null 2>&1 && NGINX_WAS_OK=1

  cp "$A/nginx/_panel.conf" /etc/nginx/conf.d/_panel.conf

  if [ "$NGINX_WAS_OK" = 1 ] && ! nginx -t >/dev/null 2>&1; then
    if [ -f "$ROLLBACK_DIR/_panel.conf" ]; then
      cp -a "$ROLLBACK_DIR/_panel.conf" /etc/nginx/conf.d/_panel.conf
      warn "the new panel nginx vhost fails nginx -t; the previous one was restored"
    else
      rm -f /etc/nginx/conf.d/_panel.conf
      warn "the new panel nginx vhost fails nginx -t; it was removed"
    fi
  else
    ok "panel nginx vhost updated"
    [ -n "$KEPT_VHOST" ] && echo "    previous vhost kept at $KEPT_VHOST"
  fi
fi
if [ -f "$A/php-fpm/roundcube.conf" ]; then
  [ -f /etc/php-fpm.d/roundcube.conf ] && cp -a /etc/php-fpm.d/roundcube.conf "$ROLLBACK_DIR/roundcube.conf" 2>/dev/null || true
  cp "$A/php-fpm/roundcube.conf" /etc/php-fpm.d/roundcube.conf
  mkdir -p /var/lib/roundcube/{temp,sessions}
  chown -R apache:apache /var/lib/roundcube 2>/dev/null || true
  command -v restorecon >/dev/null && restorecon -R /var/lib/roundcube >/dev/null 2>&1 || true
  ok "roundcube PHP-FPM pool updated"
fi

if [ -d "$A/ops" ]; then
  # Snapshot each currently-installed ops tool the release is about to overwrite,
  # plus the scripts source dir, so a failed release does not leave new ops code
  # in place after the binary rolls back.
  mkdir -p "$ROLLBACK_DIR/opsbin"
  for t in "$A"/ops/*; do
    bn=$(basename "$t"); dest="$OPSBIN/${bn%.sh}"
    [ -f "$dest" ] && cp -a "$dest" "$ROLLBACK_DIR/opsbin/${bn%.sh}" 2>/dev/null || true
  done
  [ -d "$SCRIPTS" ] && cp -a "$SCRIPTS" "$ROLLBACK_DIR/scripts" 2>/dev/null || true
  # A configuration file is not a tool, and an editor or patch leftover is stale
  # code that root could run by mistake. Without this, `50-servika-jail.conf`
  # landed in $OPSBIN as an executable. The panel reads that file from $SCRIPTS,
  # which the copy below fills.
  for t in "$A"/ops/*; do
    bn=$(basename "$t")
    case "$bn" in
      *.conf|*.service|*.timer|*.bak|*.bak.*|*.orig|*.rej|*~) continue ;;
    esac
    install -m 0755 "$t" "$OPSBIN/${bn%.sh}" 2>/dev/null || true
  done
  mkdir -p "$SCRIPTS"; cp "$A"/ops/* "$SCRIPTS/" 2>/dev/null || true
  # Remove the legacy standalone backup cron and runner. Scheduled domain backups now
  # run inside the panel process, which honors per-domain frequency, hour, and retention.
  # Leaving these would back up each domain twice.
  rm -f /etc/cron.d/servika-backup "$OPSBIN/servika-backup-all" "$SCRIPTS/servika-backup-all" 2>/dev/null || true
  ok "operations tools updated"
fi

# Targeted repair. Every release installs a new servika-repair a few lines above
# and nothing here ever RAN it, so a repair section added to that tool reached
# the fleet's disk and executed only on a fresh install, where servika-install.sh
# runs it once, bare.
#
# The bare run is not what belongs here. These four sections are the ones the
# running panel does NOT perform: provisioner.Init repairs phpMyAdmin, the nginx
# cache and tenant homes at every start, and firewall.TakeOverFirewalld masks
# firewalld, so naming those would only repeat what the restart below does
# anyway. `domains` is left out for a stronger reason than redundancy: measured
# on a host with no nginx account, its ACL read test fails and the fallback runs
# `chown -R` across a live document root and turns public_html 0750 into 2750.
#
# `mail` is conditional because on a host that never ran the mail setup the
# section prints eight "absent" warnings on every update. The marker is the file
# mail.HealMailOnStartup already reads as "the mail setup ran".
#
# The output is deliberately NOT redirected: --quiet prints only what it FIXED,
# so a healthy server stays silent and a repaired one says what it repaired. A
# rollback does not undo any of this, and must not: permissions and SELinux
# labels belong to the host, never to the release being rolled back.
REPAIR_SECTIONS="htpasswd,clamav,frontend,signon"
if [ -f /etc/postfix/mysql-virtual-domains.cf ]; then
  REPAIR_SECTIONS="$REPAIR_SECTIONS,mail"
fi
if command -v servika-repair >/dev/null 2>&1; then
  if servika-repair --quiet --only "$REPAIR_SECTIONS"; then
    ok "targeted repair ($REPAIR_SECTIONS)"
  else
    warn "the targeted repair reported an error; run: servika-repair --only $REPAIR_SECTIONS"
  fi
elif [ -x "$OPSBIN/servika-repair" ]; then
  # On disk but unresolvable: without this branch the whole step vanishes from
  # the output and the update reports success having skipped it.
  warn "servika-repair is installed but not resolvable on PATH, so the targeted repair did not run"
else
  warn "servika-repair is absent, so the targeted repair did not run"
fi

# Install prerequisites on systems created before they became base packages.
# 9b) WAF (ModSecurity + OWASP CRS) heal — IDEMPOTENT (fast exit when everything is ready).
# Rebuilds the connector when the nginx version changes (ABI). nginx -t GATE + rollback →
# main nginx is never broken. When the module is not loaded, panel WAF skips gracefully.
if command -v servika-waf-setup >/dev/null 2>&1; then
  servika-waf-setup >/dev/null 2>&1 && ok "WAF infrastructure synchronized (ModSecurity+CRS)" || warn "waf-setup skipped (WAF runs gracefully without the module)"
elif [ -x /usr/local/bin/servika-waf-setup ]; then
  # On disk but unresolvable: without this branch the whole step vanishes from
  # the output and the update reports success having skipped it.
  warn "servika-waf-setup is installed but not resolvable on PATH, WAF was not synchronized"
fi

command -v bwrap >/dev/null 2>&1 || dnf install -y bubblewrap >/dev/null 2>&1 || true
command -v setfacl >/dev/null 2>&1 || dnf install -y acl >/dev/null 2>&1 || true
command -v bsdtar >/dev/null 2>&1 || dnf install -y libarchive >/dev/null 2>&1 || true
command -v unar >/dev/null 2>&1 || dnf install -y unar >/dev/null 2>&1 || true
# lftp and sshpass drive the off-site backup destinations (FTP/SFTP). They were
# missing from the installer's package list, so the feature failed on every host
# installed before that was corrected. Both live in AppStream. Idempotent.
command -v lftp >/dev/null 2>&1 || dnf install -y lftp >/dev/null 2>&1 || true
command -v sshpass >/dev/null 2>&1 || dnf install -y sshpass >/dev/null 2>&1 || true
command -v restorecon >/dev/null && restorecon -R "$PREFIX/bin" "$FDIST" >/dev/null 2>&1 || true

# 10b) Disk quota (XFS user quota) GRUB configuration — does NOT auto-reboot live servers.
# When the root filesystem is XFS + noquota, idempotently write `rootflags=uquota` to
# /etc/default/grub. Quota can only be enabled at MOUNT time (via reboot). The operator
# schedules the reboot — a sentinel file + clear warning are left. Panel startup's
# HealQuotaOnStartup applies limits automatically once the filesystem quota is active.
command -v quota >/dev/null 2>&1 || dnf install -y quota xfsprogs >/dev/null 2>&1 || true
QROOTFS=$(findmnt -no FSTYPE / 2>/dev/null || echo "")
QROOTOPTS=$(findmnt -no OPTIONS / 2>/dev/null || echo "")
QSENTINEL=/etc/servika/reboot-required-quota
if [ "$QROOTFS" = "xfs" ] && ! echo "$QROOTOPTS" | grep -qwE 'usrquota|uquota|quota'; then
  if ! grep -q 'rootflags=uquota' /etc/default/grub 2>/dev/null; then
    if grep -q '^GRUB_CMDLINE_LINUX=' /etc/default/grub 2>/dev/null; then
      sed -i 's/^\(GRUB_CMDLINE_LINUX="[^"]*\)"/\1 rootflags=uquota"/' /etc/default/grub
    else
      echo 'GRUB_CMDLINE_LINUX="rootflags=uquota"' >> /etc/default/grub
    fi
    command -v grubby >/dev/null 2>&1 && grubby --update-kernel=ALL --args="rootflags=uquota" >/dev/null 2>&1 || true
    grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 || true
    for cfg in /boot/efi/EFI/*/grub.cfg; do [ -f "$cfg" ] && grub2-mkconfig -o "$cfg" >/dev/null 2>&1 || true; done
  fi
  mkdir -p /etc/servika
  echo "rootflags=uquota written to GRUB $(date -Is 2>/dev/null) — reboot pending" > "$QSENTINEL" 2>/dev/null || true
  warn "Disk quota: GRUB updated — a SINGLE reboot is required to activate (the operator schedules it on the live server). AUTO-REBOOT WAS NOT PERFORMED."
elif [ "$QROOTFS" = "xfs" ]; then
  [ -f "$QSENTINEL" ] && rm -f "$QSENTINEL" 2>/dev/null && ok "disk quota active — reboot sentinel cleared" || ok "disk quota active (root XFS user quota)"
fi

# Backfill SERVIKA_SECRET_KEY for installs that predate at-rest secret
# encryption. The server now requires it at boot, so it must exist before the
# restart below or the updated binary fails to start.
if ! grep -q '^SERVIKA_SECRET_KEY=' "$ENV_FILE" 2>/dev/null; then
  step "Provisioning at-rest encryption key"
  NEWKEY=$(openssl rand -hex 32)
  tmp=$(mktemp)
  cp -a "$ENV_FILE" "$tmp"
  printf 'SERVIKA_SECRET_KEY=%s\n' "$NEWKEY" >> "$tmp"
  install -m 600 -o root -g root "$tmp" "$ENV_FILE"
  rm -f "$tmp"
  ok "SERVIKA_SECRET_KEY generated"
fi

step "Restarting"
systemctl restart "$SVC"
HEALTHY=0
for _i in 1 2 3 4 5 6; do
  sleep 2
  if systemctl is-active --quiet "$SVC" && curl -fsS "$HEALTH" >/dev/null 2>&1; then HEALTHY=1; break; fi
done

if [ "$HEALTHY" = 1 ]; then
  if command -v servika-mail-setup >/dev/null 2>&1; then
    servika-mail-setup >/dev/null 2>&1 && ok "mail infrastructure synchronized (Postfix+Dovecot+OpenDKIM+Roundcube)" || warn "mail-setup skipped"
  elif [ -x /usr/local/bin/servika-mail-setup ]; then
    warn "servika-mail-setup is installed but not resolvable on PATH, mail was not synchronized"
  fi
  systemctl reload nginx >/dev/null 2>&1 || true
  rm -rf "$ROLLBACK_DIR" 2>/dev/null || true
  echo "$RELHASH" > "$MARKER" 2>/dev/null || true
  NEWVER=$(version); [ -n "$NEWVER" ] || NEWVER="?"
  ok "panel active and health check passed"
  ok "resource limits applied from plans + existing sites are being safely migrated to per-tenant PHP-FPM isolation (self-check + auto-rollback, in the background)"
  # An active service and a healthy /healthz say the process started, not that
  # the server works: the same two answers were true on a host whose catch-all
  # returned 500 for every Host and whose wp-cli was a corrupt file. This
  # measures production behaviour instead.
  #
  # It does not roll back. The update is already applied and the rollback is a
  # separate mechanism above, so undoing anything here is not on the table, and
  # the warning and the completion banner are printed exactly as before. What it
  # does change is the EXIT STATUS: an operator reads the warning, but the
  # pipeline, cron job or configuration-management run that invoked this reads
  # only the status, and 0 told every one of them that a server this tool had
  # just called CRITICAL was fine.
  VERIFY_FAILED=0
  if command -v servika-verify >/dev/null 2>&1; then
    echo
    if ! servika-verify --brief; then
      VERIFY_FAILED=1
      warn "the update was applied but verification found a CRITICAL problem (above); details: servika-verify"
    fi
  elif [ -x /usr/local/bin/servika-verify ]; then
    warn "servika-verify is installed but not resolvable on PATH, so the update was not verified"
  fi
  echo -e "${c_g}══ Update complete ($CURVER to $NEWVER); environment, database, and sites preserved ══${c_0}"
else
  warn "the new release failed its health check; restoring the previous release"
  install -m 0755 "$BIN.bak" "$BIN"
  [ -f "$SEED.bak" ] && install -m 0755 "$SEED.bak" "$SEED" 2>/dev/null || true
  command -v restorecon >/dev/null && restorecon "$BIN" >/dev/null 2>&1 || true
  # Restore every other release-owned asset (frontend, migrations, mail, nginx,
  # roundcube, ops tools) so the old binary does not run against new assets.
  restore_release_assets

  # Stop all panel writes, verify the recovery point again, then restore the pre-update schema
  # and data before starting the previous binary.
  systemctl stop "$SVC" >/dev/null 2>&1 || true
  if [ -n "$PRE_UPDATE_DUMP" ] && [ -f "$PRE_UPDATE_DUMP" ] \
    && gzip -t "$PRE_UPDATE_DUMP" && gunzip -c "$PRE_UPDATE_DUMP" | mysql; then
    ok "database restored from $PRE_UPDATE_DUMP"
  else
    warn "database restore failed; the recovery dump remains at $PRE_UPDATE_DUMP"
  fi

  systemctl restart "$SVC"; sleep 3
  if systemctl is-active --quiet "$SVC"; then
    die "rollback completed and the previous release is active; inspect journalctl -u servika -n 40"
  else
    die "rollback failed to start Servika; inspect journalctl -u servika -n 40 (database dump: $PRE_UPDATE_DUMP)"
  fi
fi

# The banner above is unchanged; only the status an automated caller reads is.
if [ "${VERIFY_FAILED:-0}" -eq 1 ]; then
  exit 1
fi
