#!/usr/bin/env bash
# servika-verify proves that an installation or an update actually works.
#
#   servika-verify           # full report
#   servika-verify --brief   # summary plus failures only (installer and updater)
#   servika-verify --json    # machine readable
#
# WHY IT EXISTS
#
# The installer's verification step used to be decorative. It printed the state
# of the server and then printed the success banner whatever it had found, so a
# run could report a missing tool, a stopped service and a catch-all answering
# 500 for every Host, and still finish with "installation complete". Nothing an
# operator saw there could stop anything.
#
# This tool replaces that step and is a GATE: when a critical check fails it
# exits 1 and the caller does not print the banner.
#
# DESIGN RULES
#
# 1. Measure the PRODUCTION path, not the installation step. "the chmod ran" and
#    "nginx can actually read it" are different claims; measure the second.
# 2. A check that could not be MEASURED has FAILED. Empty output is not "clean",
#    so there is no `|| echo 0` anywhere here: a curl that cannot connect reports
#    NO-CONNECTION rather than an empty string, which would compare equal to 0
#    in a numeric test and pass the check by accident.
# 3. 401 and 404 are not the same answer. 401 means the route is registered and
#    asking for identity, which is correct. 404 means the route is not there at
#    all, which means the binary or the router is broken. A check that treats
#    "not 200" as "protected" is lying.
# 4. No pipe into `grep -q`: grep closes the pipe at the first match, the command
#    above it takes SIGPIPE, and pipefail then reports the whole pipeline failed.
# 5. Every check must have a path on which it can fail. One that cannot fail is
#    not measuring anything.
# 6. A fallback that GUESSES makes a wrong measurement look like a right one.
#    Nothing here guesses a port; the panel's own binary reports them.
#
# CRITICAL means the panel does not work. WARNING means a feature is missing.
set -uo pipefail

# sudo builds PATH from scratch out of secure_path, which on AlmaLinux 10 is
# /sbin:/bin:/usr/sbin:/usr/bin and excludes /usr/local/bin, where this tool and
# its siblings live. Resolvability from PATH is one of the things measured below,
# so this has to run first or the tool would report its own environment.
case ":$PATH:" in
  *:/usr/local/bin:*) : ;;
  *) export PATH="/usr/local/sbin:/usr/local/bin:$PATH" ;;
esac

# Parse in the C locale. Under tr_TR.UTF-8 the ranges `a-z` and `A-Z` do NOT
# contain `i` or `I`, so every character-range parse is cut at the first one
# (measured: `grep -oE '[a-zA-Z0-9_]+'` answers `aud` for `audit_log`). The
# brand name SERVIKA carries an I, so this reaches the environment loader too.
export LC_ALL=C

ENV_FILE=/etc/servika/env

# Read the configuration the PANEL runs on, the way the other eleven ops scripts
# do. This tool was the only one without a loader, and nothing exports these:
# servika-install.sh sets not one of them in its own environment, so every
# `${SERVIKA_*:-default}` below resolved to the default. On a stock server the
# defaults are right, because the installer manages every path key. On a server
# whose operator edited the environment file afterwards (an update preserves that
# edit) they are wrong, and this tool then measured a path the panel does not
# use: a relocated SERVIKA_BIN alone produces three criticals, because the ports
# become unreadable.
#
# ENV_PERM_PROBLEM is the one deliberate difference from the other scripts. They
# EXIT on an exposed environment file because they are about to write with those
# credentials; this one is a REPORT, and a single line where a report should be
# loses everything else it had to say. The reason is recorded instead, the values
# are not read, and the Files section states it as the critical finding it is.
ENV_PERM_PROBLEM=""
load_servika_env() {
  [ -f "$ENV_FILE" ] || return 0
  [ "$(stat -c %u "$ENV_FILE" 2>/dev/null)" = 0 ] || { ENV_PERM_PROBLEM="it is not owned by root"; return 0; }
  local mode
  mode=$(stat -c %a "$ENV_FILE" 2>/dev/null) || { ENV_PERM_PROBLEM="its mode could not be read"; return 0; }
  [ $((8#$mode & 077)) -eq 0 ] || { ENV_PERM_PROBLEM="its mode is $mode, readable beyond root"; return 0; }

  while IFS= read -r line || [ -n "$line" ]; do
    # POSIX classes, never `A-Za-z0-9`: a range is collation-ordered and under
    # tr_TR.UTF-8 it excludes `i`, which silently skipped SERVIKA_LISTEN.
    [[ "$line" =~ ^[[:space:]]*(SERVIKA_[[:alnum:]_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]%$'\r'}
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then value=${value:1:${#value}-2}; fi
    if [[ "$value" == \'*\' && "$value" == *\' ]]; then value=${value:1:${#value}-2}; fi
    if [ -z "${!key+x}" ]; then
      printf -v "$key" '%s' "$value"
      export "${key?}"
    fi
  done < "$ENV_FILE"
}

load_servika_env

BRIEF=0; JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --brief) BRIEF=1 ;;
    --json)  JSON=1; BRIEF=1 ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

c_g=$'\033[32m'; c_y=$'\033[33m'; c_r=$'\033[31m'; c_b=$'\033[1m'; c_0=$'\033[0m'
[ -t 1 ] || { c_g=; c_y=; c_r=; c_b=; c_0=; }

PASSED=0; CRITICAL=0; WARNINGS=0
FAILURES=()

pass() { PASSED=$((PASSED+1)); [ $BRIEF -eq 1 ] || printf "  ${c_g}OK${c_0}   %-32s %s\n" "$1" "${2:-}"; }
crit() { CRITICAL=$((CRITICAL+1)); FAILURES+=("CRITICAL|$1|${2:-}")
         [ $JSON -eq 1 ] || printf "  ${c_r}FAIL${c_0} %-32s %s\n" "$1" "${2:-}"; }
warn() { WARNINGS=$((WARNINGS+1)); FAILURES+=("WARNING|$1|${2:-}")
         [ $JSON -eq 1 ] || printf "  ${c_y}WARN${c_0} %-32s %s\n" "$1" "${2:-}"; }
section() { [ $BRIEF -eq 1 ] || printf "\n${c_b}== %s ==${c_0}\n" "$*"; }

# http_code answers with the status, or NO-CONNECTION when it could not connect.
# It must never answer with an empty string: "$code" -eq 200 style comparisons
# treat empty as 0, and a check that cannot reach the server would pass.
http_code() { # $1=url  $2=host header (optional)
  local code
  if [ -n "${2:-}" ]; then
    code=$(curl -sk -o /dev/null -w '%{http_code}' -H "Host: $2" --max-time 10 "$1" 2>/dev/null)
  else
    code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2>/dev/null)
  fi
  if [ -n "$code" ] && [ "$code" != "000" ]; then echo "$code"; else echo "NO-CONNECTION"; fi
}

# http_body answers with the response body, or NO-CONNECTION when it could not
# connect. It never answers with an empty string, for the same reason http_code
# never does; the one route it is used on always writes a body.
http_body() {
  local body
  body=$(curl -sk --max-time 10 "$1" 2>/dev/null)
  if [ -n "$body" ]; then printf '%s' "$body"; else echo "NO-CONNECTION"; fi
}

# svc answers with ONE line. `systemctl is-active X || echo unknown` answers with
# two: systemctl PRINTS "inactive" on stdout and ALSO exits non-zero, so the ||
# branch runs as well and the variable becomes "inactive\nunknown". printf then
# writes the second line bare, with no check name beside it. Measured against
# real systemd: an unknown unit gave exactly that pair.
svc() {
  local state
  state=$(systemctl is-active "$1" 2>/dev/null)
  state=${state%%$'\n'*}
  if [ -n "$state" ]; then echo "$state"; else echo "unknown"; fi
}

# running_binary_state <unit> <installed path>: print a reason and answer 0 when
# the running process IS the installed binary, 1 when it provably is not, and 2
# when it could not be measured. `servika-install.sh` carries the same function
# for the same reason; the two ops scripts share no library.
#
# "the service is up" and "the binary on disk is running" are different claims.
# Measured against real systemd: after `install` replaced the binary,
# `systemctl enable --now` left MainPID unchanged and `is-active` still answered
# "active" while the OLD process kept serving.
#
# The comparison is by CONTENT, never by inode. `/proc/<pid>/exe` reports
# procfs's own device number, so `stat -c '%d:%i'` on it can never equal the
# installed file and a check built that way calls every server stale (measured:
# 97:44078762 against 1048642:63995942 for one running program).
#
# `install` gives the replacement a NEW inode, so the old one stays open in the
# running process and readlink reports it with a " (deleted)" suffix. That is the
# cheap half; the checksum catches a replacement made some other way.
running_binary_state() {
  local unit="$1" installed="$2" pid link running_hash installed_hash
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  pid=${pid%%$'\n'*}
  if [ -z "$pid" ] || [ "$pid" = "0" ]; then
    echo "the unit reports no main process (MainPID=${pid:-empty})"; return 2
  fi
  if [ ! -r "/proc/$pid/exe" ]; then
    echo "/proc/$pid/exe could not be read"; return 2
  fi
  if [ ! -f "$installed" ]; then
    echo "the installed binary is missing ($installed)"; return 1
  fi
  link=$(readlink "/proc/$pid/exe" 2>/dev/null)
  case "$link" in
    *" (deleted)") echo "the running process holds a DELETED file ($link)"; return 1 ;;
  esac
  running_hash=$(sha256sum "/proc/$pid/exe" 2>/dev/null | awk '{print $1}')
  installed_hash=$(sha256sum "$installed" 2>/dev/null | awk '{print $1}')
  if [ -z "$running_hash" ] || [ -z "$installed_hash" ]; then
    echo "the checksums could not be taken"; return 2
  fi
  if [ "$running_hash" = "$installed_hash" ]; then
    echo "running process = installed binary"; return 0
  fi
  echo "the running process is a DIFFERENT binary (${link:-unknown})"; return 1
}

# ── The panel's own ports ─────────────────────────────────────────────────────
# Read from the binary, which reads them from the files that hold them and
# refuses rather than guessing. Nothing here falls back to a number: the panel
# can move both of its ports, and a check that connected to the old one would
# report a healthy server as broken, or a stopped one as fine.
section "Panel ports"
SERVIKA_BIN_PATH="${SERVIKA_BIN:-/opt/servika/bin/servika-server}"
PORT_BACKEND=""; PORT_EXTERNAL=""; PORT_HEALTH=""
if [ ! -x "$SERVIKA_BIN_PATH" ]; then
  crit "panel binary" "$SERVIKA_BIN_PATH is missing or not executable"
else
  if ! PORTS_OUT=$("$SERVIKA_BIN_PATH" -print-ports 2>&1); then
    crit "panel ports" "could not be read: $PORTS_OUT"
  else
    while IFS='=' read -r key value; do
      case "$key" in
        backend)    PORT_BACKEND="$value" ;;
        external)   PORT_EXTERNAL="$value" ;;
        health_url) PORT_HEALTH="$value" ;;
      esac
    done <<< "$PORTS_OUT"
    if [ -n "$PORT_BACKEND" ] && [ -n "$PORT_EXTERNAL" ]; then
      pass "panel ports" "backend $PORT_BACKEND, external $PORT_EXTERNAL"
    else
      crit "panel ports" "the binary answered but named no ports"
    fi
  fi
fi

# ── The process behind the panel ─────────────────────────────────────────────
# A panel that is up on a binary it no longer runs answers every check below
# with the OLD code, so this comes before them. It happens whenever something
# replaced the binary without restarting the service, which systemd reports as
# "active" throughout. CRITICAL because the code serving this server is not the
# code installed on it, and an unmeasurable answer is critical too, since this
# is the tool whose whole contract is to measure.
section "Running process"
BINARY_REASON=$(running_binary_state servika "$SERVIKA_BIN_PATH")
case $? in
  0) pass "running binary" "$BINARY_REASON" ;;
  1) crit "running binary" "$BINARY_REASON (systemctl restart servika)" ;;
  *) crit "running binary" "NOT MEASURED: $BINARY_REASON" ;;
esac

# ── Services ─────────────────────────────────────────────────────────────────
section "Services"
# Without these four there is no panel and no site.
for s in servika nginx mariadb php-fpm; do
  state=$(svc "$s")
  if [ "$state" = "active" ]; then pass "$s" "active"
  else crit "$s" "$state (the panel cannot work without it)"; fi
done
# The panel opens without these; a feature does not.
for s in valkey named crond postfix dovecot opendkim pure-ftpd httpd; do
  state=$(svc "$s")
  if [ "$state" = "active" ]; then pass "$s" "active"; else warn "$s" "$state"; fi
done

# ── Panel HTTP surface ───────────────────────────────────────────────────────
section "Panel HTTP surface"
if [ -z "$PORT_EXTERNAL" ] || [ -z "$PORT_BACKEND" ]; then
  # A check that could not be measured has failed. Connecting to a guessed port
  # and reporting the answer would be worse than saying so.
  crit "panel page" "NOT MEASURED (the ports are unknown)"
  crit "/healthz" "NOT MEASURED (the ports are unknown)"
  crit "API authentication" "NOT MEASURED (the ports are unknown)"
else
  code=$(http_code "https://127.0.0.1:${PORT_EXTERNAL}/")
  if [ "$code" = "200" ]; then pass "panel page" "HTTP 200 on :$PORT_EXTERNAL"
  else crit "panel page" "HTTP $code on :$PORT_EXTERNAL (200 expected)"; fi

  # A status code alone says only that SOMETHING answered on that port. The
  # panel can be down while an unrelated service holds the port and answers 200
  # to everything, which is the state this check exists to catch, so the body is
  # read and required to be the panel's own readiness answer. That answer also
  # carries the running version, which is the cheapest proof that the process
  # serving the port is the release just installed.
  HEALTH_URL="${PORT_HEALTH:-http://127.0.0.1:${PORT_BACKEND}/healthz}"
  code=$(http_code "$HEALTH_URL")
  if [ "$code" != "200" ]; then
    crit "/healthz" "HTTP $code on :$PORT_BACKEND (200 expected)"
  else
    HEALTH_BODY=$(http_body "$HEALTH_URL")
    # Spaces are removed rather than matched, so the check holds whether the
    # encoder writes compact or spaced JSON.
    HEALTH_NORM=${HEALTH_BODY// /}
    HEALTH_VER=$(printf '%s' "$HEALTH_BODY" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    case "$HEALTH_NORM" in
      *'"status":"up"'*)
        pass "/healthz" "HTTP 200 on :$PORT_BACKEND, the panel answered (version ${HEALTH_VER:-unreported})" ;;
      *)
        crit "/healthz" "HTTP 200 on :$PORT_BACKEND but the body is NOT the panel's, so another service holds that port" ;;
    esac
  fi

  # 401 says the route exists and is protected. 404 says the route was never
  # registered, which means the binary or the frontend is not the one this
  # release ships. Treating anything that is not 200 as "protected" would report
  # a broken router as a working guard.
  code=$(http_code "https://127.0.0.1:${PORT_EXTERNAL}/api/v1/domains")
  case "$code" in
    401) pass "API authentication" "HTTP 401 (route registered, guard working)" ;;
    404) crit "API authentication" "HTTP 404 (the route is not registered at all)" ;;
    200) crit "API authentication" "HTTP 200 (the API answered without a session)" ;;
    *)   crit "API authentication" "HTTP $code (401 expected)" ;;
  esac
fi

# ── Catch-all vhosts ─────────────────────────────────────────────────────────
section "Catch-all vhosts"
# Both catch-alls declare `try_files $uri /index.html`, so a missing document
# root page turns every request with an unmatched Host into an internal
# redirection cycle and a 500. nginx -t passes in that state, so this is the only
# thing that can find it.
code=$(http_code "http://127.0.0.1/" "unmatched-host.invalid")
case "$code" in
  5*)            crit "port 80 catch-all" "HTTP $code (unmatched hosts get an error)" ;;
  NO-CONNECTION) crit "port 80 catch-all" "could not connect" ;;
  *)             pass "port 80 catch-all" "HTTP $code" ;;
esac
code=$(http_code "https://127.0.0.1/" "unmatched-host.invalid")
case "$code" in
  5*|NO-CONNECTION) warn "port 443 catch-all" "HTTP $code" ;;
  *)                pass "port 443 catch-all" "HTTP $code" ;;
esac

# ── nginx ────────────────────────────────────────────────────────────────────
section "nginx"
if ! command -v nginx >/dev/null 2>&1; then
  # Not the same finding as an invalid configuration, and saying so matters:
  # one is a file to fix, the other is a package that was never installed.
  crit "nginx -t" "nginx is not installed, so this was NOT MEASURED"
elif nginx -t >/dev/null 2>&1; then
  pass "nginx -t" "valid"
else
  crit "nginx -t" "the configuration is INVALID, the next reload will fail"
fi

# Measure the production path: a permission bit says nothing if a parent
# directory is 0700 root:root, and fastcgi_cache then fails silently because
# nginx itself stays up.
CACHE_DIR="${SERVIKA_NGINX_CACHE_DIR:-/var/cache/nginx/servikacache}"
if [ ! -d "$CACHE_DIR" ]; then
  warn "nginx cache directory" "$CACHE_DIR does not exist"
elif ! command -v runuser >/dev/null 2>&1; then
  warn "nginx cache access" "runuser is missing, so this was NOT MEASURED"
elif runuser -u nginx -- sh -c 'f="$1/.servika-verify.$$"; : > "$f" 2>/dev/null || exit 1; rm -f "$f"' _ "$CACHE_DIR" 2>/dev/null; then
  pass "nginx cache access" "nginx can write into it"
else
  # A read test passes on a directory nginx can enter but not write, and
  # fastcgi_cache is a WRITE path: every response it is meant to store is
  # silently dropped. Measure what the production path does.
  warn "nginx cache access" "nginx CANNOT write into it, fastcgi_cache is dead (servika-repair)"
fi

# schema_from_migrations reads the migration files and prints what they say the
# schema must hold: one `T<TAB>table` per surviving table and one `C<TAB>table.column`
# per column an ALTER added. It is the only way to tell a migration that was
# RECORDED as applied from one whose statements all landed.
#
# Four things were measured against the real files and each one silently loses
# whole tables when it is got wrong:
#
#  * A statement is accumulated line by line and cut at `;` only AFTER the `--`
#    comment on that line is removed. Splitting the raw text on `;` first loses
#    every statement whose header comment contains one, which 0066 does.
#  * The pending statement is FLUSHED at the end of each file. Five migration
#    files (0018-0022) end with no trailing `;`, so a parser that drops the tail
#    loses their entire CREATE TABLE.
#  * The optional `IF NOT EXISTS` / `IF EXISTS` group is stepped OVER, never read
#    as the name. Read positionally it yields a table called `if`, which is then
#    reported missing on every healthy server.
#  * `DROP TABLE`, `DROP COLUMN` and `CHANGE COLUMN` are replayed in order, so a
#    name a later migration removed or renamed is not demanded of the server.
#    0026 renames `domain_redis.sk` and 0093 drops four `queue_*` columns.
#
# tolower() is safe here only because this script runs under LC_ALL=C; under
# tr_TR.UTF-8 it answers `sıte_ıd` for SITE_ID.
schema_from_migrations() {
  awk '
  function strip(n) { gsub(/[(),]/, "", n); return n }
  function droptable(n,   k) {
    delete tab[n]
    for (k in col) if (index(k, n ".") == 1) delete col[k]
  }
  function handle(s,   st, w, nw, i, j, t) {
    gsub(/`/, " ", s)
    gsub(/[ \t\r\n]+/, " ", s)
    st = tolower(s)
    nw = split(st, w, " ")
    if (nw < 3) return
    if (w[1] == "create" && w[2] == "table") {
      j = 3
      if (w[j] == "if" && w[j+1] == "not" && w[j+2] == "exists") j += 3
      t = strip(w[j]); if (t != "") tab[t] = 1
    } else if (w[1] == "drop" && w[2] == "table") {
      j = 3
      if (w[j] == "if" && w[j+1] == "exists") j += 2
      for (; j <= nw; j++) { t = strip(w[j]); if (t != "") droptable(t) }
    } else if (w[1] == "alter" && w[2] == "table") {
      t = strip(w[3])
      for (i = 4; i <= nw; i++) {
        if (w[i] == "add" && w[i+1] == "column") {
          j = i + 2
          if (w[j] == "if" && w[j+1] == "not" && w[j+2] == "exists") j += 3
          col[t "." strip(w[j])] = 1; i = j
        } else if (w[i] == "drop" && w[i+1] == "column") {
          j = i + 2
          if (w[j] == "if" && w[j+1] == "exists") j += 2
          delete col[t "." strip(w[j])]; i = j
        } else if (w[i] == "change" && w[i+1] == "column") {
          delete col[t "." strip(w[i+2])]
          col[t "." strip(w[i+3])] = 1; i += 3
        }
      }
    }
  }
  FNR == 1 { if (stmt != "") handle(stmt); stmt = "" }
  {
    line = $0
    sub(/(^|[ \t])--([ \t].*)?$/, "", line)
    stmt = stmt " " line
    while ((p = index(stmt, ";")) > 0) {
      handle(substr(stmt, 1, p - 1))
      stmt = substr(stmt, p + 1)
    }
  }
  END {
    if (stmt != "") handle(stmt)
    for (k in tab) print "T\t" k
    for (k in col) print "C\t" k
  }' "$@"
}

# ── Database ─────────────────────────────────────────────────────────────────
section "Database"
# Connect the way the PANEL connects, never as root. root over the unix socket
# always answers, so a check built on it stays green when the password in the
# environment file is wrong or the GRANT was revoked, which is precisely the
# state in which the panel cannot start. The password travels through a 0600
# defaults file and never through argv, the same way servika-install.sh proves
# the account it just created.
# db_defaults_file sets DB_DEFAULTS, DB_NAME and DB_WHO from the panel DSN, and
# answers non-zero when it cannot parse it. It ASSIGNS rather than prints: a
# command substitution would run it in a subshell, where the other two values
# never reach the caller (measured, and the empty database name then made the
# migration query fail as "not measured").
db_defaults_file() {
  local dsn="$1" rest creds netpart proto addr db user pass file
  rest=${dsn%%\?*}
  case "$rest" in *@*) ;; *) return 1 ;; esac
  creds=${rest%@*}
  netpart=${rest##*@}
  user=${creds%%:*}
  case "$creds" in *:*) pass=${creds#*:} ;; *) pass="" ;; esac
  [ -n "$user" ] || return 1
  case "$netpart" in
    *'('*')'*) proto=${netpart%%(*}; addr=${netpart#*(}; addr=${addr%%)*}; db=${netpart##*)/} ;;
    *)         proto=""; addr=""; db=${netpart##*/} ;;
  esac
  [ -n "$db" ] || return 1
  file=$(mktemp) || return 1
  chmod 600 "$file" || { rm -f "$file"; return 1; }
  {
    printf '[client]\nuser=%s\n' "$user"
    [ -n "$pass" ] && printf 'password=%s\n' "$pass"
    case "$proto" in
      unix) printf 'socket=%s\n' "$addr" ;;
      tcp)  printf 'host=%s\nport=%s\n' "${addr%:*}" "${addr##*:}" ;;
    esac
  } > "$file"
  DB_DEFAULTS="$file"; DB_NAME="$db"; DB_WHO="$user@${addr:-local}/$db"
}

DB_NAME=""; DB_WHO=""; DB_DEFAULTS=""
# The loader at the top already read this, quotes stripped, taking the LAST
# assignment the way the panel's own unit does.
DB_DSN="${SERVIKA_DB_DSN:-}"
if [ -z "$DB_DSN" ]; then
  # Naming the cause matters: a refused read and an absent setting call for
  # different repairs, and the second message sends an operator looking for a
  # line that is already there.
  if [ -n "$ENV_PERM_PROBLEM" ]; then
    crit "panel database identity" "$ENV_FILE was NOT read ($ENV_PERM_PROBLEM), so the database was not measured"
  else
    crit "panel database identity" "SERVIKA_DB_DSN could not be read from $ENV_FILE"
  fi
else
  db_defaults_file "$DB_DSN" || DB_DEFAULTS=""
  [ -n "$DB_DEFAULTS" ] || crit "panel database identity" "SERVIKA_DB_DSN could not be parsed"
fi

if [ -n "$DB_DEFAULTS" ] && mysql --defaults-extra-file="$DB_DEFAULTS" -N -e 'SELECT 1' >/dev/null 2>&1; then
  pass "MariaDB connection" "the panel's own credentials answered ($DB_WHO)"
  MIGRATIONS=$(mysql --defaults-extra-file="$DB_DEFAULTS" -N -e 'SELECT COUNT(*) FROM schema_migrations;' "$DB_NAME" 2>/dev/null)
  # DATABASE() rather than the name interpolated into the statement: mysql is
  # already connected to that schema, so there is nothing to quote and nothing
  # a name out of the environment file could change about the query.
  TABLES=$(mysql --defaults-extra-file="$DB_DEFAULTS" -N -e 'SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE();' "$DB_NAME" 2>/dev/null)
  # The expected number is the number of files on disk. `> 0` passed a server
  # that had applied one migration out of a hundred, which is the half-migrated
  # state the updater's rollback path exists to prevent.
  MIGR_DIR="${SERVIKA_MIGR:-/opt/servika/src/migrations}"
  # shellcheck disable=SC2012 # counting files, and these names are release-controlled
  MIGR_EXPECTED=$(ls "$MIGR_DIR"/*.sql 2>/dev/null | wc -l | tr -d ' ')
  # An empty answer is "could not measure", not "zero". Telling them apart is the
  # difference between reporting a broken query and reporting an empty schema.
  if [ -z "$MIGRATIONS" ]; then
    crit "applied migrations" "NOT MEASURED (schema_migrations could not be read)"
  elif [ "${MIGR_EXPECTED:-0}" -eq 0 ]; then
    warn "applied migrations" "$MIGRATIONS applied, but $MIGR_DIR holds no files to compare against"
  elif [ "$MIGRATIONS" -ge "$MIGR_EXPECTED" ] 2>/dev/null; then
    pass "applied migrations" "$MIGRATIONS/$MIGR_EXPECTED applied"
  else
    crit "applied migrations" "$MIGRATIONS/$MIGR_EXPECTED applied, the schema is HALF MIGRATED"
  fi
  if [ -z "$TABLES" ]; then
    crit "panel tables" "NOT MEASURED"
  elif [ "$TABLES" -gt 10 ] 2>/dev/null; then
    pass "panel tables" "$TABLES tables"
  else
    crit "panel tables" "$TABLES tables, the schema is incomplete"
  fi

  # A row in schema_migrations says a file RAN. It does not say the file that
  # ran is the file on disk now, and the panel refuses to start when they
  # differ: the runner calls log.Fatalf on a checksum mismatch. A blank stored
  # checksum is a legacy row the runner backfills, so it is not a mismatch.
  if [ "${MIGR_EXPECTED:-0}" -gt 0 ] && command -v sha256sum >/dev/null 2>&1; then
    MIGR_STATE=$(mktemp 2>/dev/null || true)
    if [ -n "$MIGR_STATE" ] \
       && mysql --defaults-extra-file="$DB_DEFAULTS" -N -B \
            -e 'SELECT filename, checksum FROM schema_migrations;' "$DB_NAME" \
            > "$MIGR_STATE" 2>/dev/null; then
      MIGR_REPORT=$(sha256sum "$MIGR_DIR"/*.sql 2>/dev/null | awk -v state="$MIGR_STATE" '
        BEGIN { while ((getline l < state) > 0) { split(l, f, "\t"); db[f[1]] = f[2] } }
        { name = $2; sub(/.*\//, "", name); total++
          if (!(name in db)) { nmiss++; if (nmiss <= 3) mn = (mn == "" ? name : mn " " name) }
          else if (db[name] != "" && db[name] != $1) { nbad++; if (nbad <= 3) bn = (bn == "" ? name : bn " " name) } }
        END { printf "%d %d %d %s|%s\n", total+0, nmiss+0, nbad+0, mn, bn }')
      read -r M_TOTAL M_MISS M_BAD M_NAMES <<< "$MIGR_REPORT"
      M_MISS_NAMES=${M_NAMES%%|*}; M_BAD_NAMES=${M_NAMES#*|}
      if [ "${M_TOTAL:-0}" -eq 0 ]; then
        crit "migration file identity" "NOT MEASURED (no file could be hashed)"
      elif [ "${M_BAD:-0}" -gt 0 ]; then
        crit "migration file identity" "$M_BAD file(s) CHANGED after being applied: $M_BAD_NAMES, so the panel REFUSES to start"
      elif [ "${M_MISS:-0}" -gt 0 ]; then
        crit "migration file identity" "$((M_TOTAL - M_MISS))/$M_TOTAL recorded, never applied: $M_MISS_NAMES"
      else
        pass "migration file identity" "$M_TOTAL/$M_TOTAL recorded, every checksum matches"
      fi
    else
      crit "migration file identity" "NOT MEASURED (schema_migrations could not be read)"
    fi
    [ -n "$MIGR_STATE" ] && rm -f "$MIGR_STATE"
  fi

  # The table COUNT only proves the schema is not empty. Derive the shape the
  # migration files describe and ask the server for it, so a migration recorded
  # as applied whose statements did not all land is visible by name.
  SCHEMA_WANT=$(mktemp 2>/dev/null || true)
  SCHEMA_HAVE=$(mktemp 2>/dev/null || true)
  if [ "${MIGR_EXPECTED:-0}" -gt 0 ] && [ -n "$SCHEMA_WANT" ] && [ -n "$SCHEMA_HAVE" ]; then
    schema_from_migrations "$MIGR_DIR"/*.sql 2>/dev/null | sort -u > "$SCHEMA_WANT"
    mysql --defaults-extra-file="$DB_DEFAULTS" -N -B -e "
      SELECT 'T', LOWER(table_name) FROM information_schema.tables
        WHERE table_schema = DATABASE()
      UNION ALL
      SELECT 'C', CONCAT(LOWER(table_name), '.', LOWER(column_name))
        FROM information_schema.columns WHERE table_schema = DATABASE();" \
      "$DB_NAME" 2>/dev/null | sort -u > "$SCHEMA_HAVE"
    # comm needs both sides sorted the same way, which LC_ALL=C above guarantees.
    SCHEMA_REPORT=$(comm -23 "$SCHEMA_WANT" "$SCHEMA_HAVE" | awk -v want="$SCHEMA_WANT" '
      { if ($1 == "T") { mt++; if (mt <= 3) tn = (tn == "" ? $2 : tn " " $2) }
        else if ($1 == "C") { mc++; if (mc <= 3) cn = (cn == "" ? $2 : cn " " $2) } }
      END {
        while ((getline l < want) > 0) { if (l ~ /^T\t/) wt++; else if (l ~ /^C\t/) wc_++ }
        printf "%d %d %d %d %s|%s\n", wt+0, wc_+0, mt+0, mc+0, tn, cn
      }')
    read -r S_WT S_WC S_MT S_MC S_NAMES <<< "$SCHEMA_REPORT"
    S_TN=${S_NAMES%%|*}; S_CN=${S_NAMES#*|}
    if [ "${S_WT:-0}" -eq 0 ]; then
      crit "schema tables" "NOT MEASURED (the migration files describe no table)"
    elif [ "${S_MT:-0}" -eq 0 ]; then
      pass "schema tables" "$S_WT/$S_WT the migrations describe are present"
    else
      crit "schema tables" "$((S_WT - S_MT))/$S_WT present, MISSING: $S_TN"
    fi
    if [ "${S_WC:-0}" -gt 0 ]; then
      if [ "${S_MC:-0}" -eq 0 ]; then
        pass "schema columns" "$S_WC/$S_WC the migrations add are present"
      else
        crit "schema columns" "$((S_WC - S_MC))/$S_WC present, MISSING: $S_CN"
      fi
    fi
  fi
  [ -n "$SCHEMA_WANT" ] && rm -f "$SCHEMA_WANT"
  [ -n "$SCHEMA_HAVE" ] && rm -f "$SCHEMA_HAVE"
elif [ -n "$DB_DEFAULTS" ]; then
  crit "MariaDB connection" "the panel's own credentials were REFUSED ($DB_WHO), so the panel cannot start"
fi
[ -n "$DB_DEFAULTS" ] && rm -f "$DB_DEFAULTS"

# ── Tools ────────────────────────────────────────────────────────────────────
section "Tools"
# Being on disk is not enough. sudo drops /usr/local/bin from PATH, and every
# step that reaches these tools by bare name then skips itself silently.
for t in servika-repair servika-update servika-restore servika-optimize \
         servika-redis-setup servika-ftp-setup servika-mail-setup servika-db-backup; do
  if [ ! -x "/usr/local/bin/$t" ]; then
    warn "$t" "not present in the package"
  elif [ ! -s "/usr/local/bin/$t" ]; then
    # An interrupted copy leaves an executable file of zero bytes. The kernel
    # runs it, the shell reads no commands, and it exits 0, so every caller that
    # only looks at the exit status reports the step as done.
    warn "$t" "installed but EMPTY, so it exits 0 without doing anything"
  elif [ "$(head -c 2 "/usr/local/bin/$t" 2>/dev/null)" != "#!" ]; then
    # Every tool here ships with one, so its absence means the file is not the
    # shipped script. A SHELL still runs such a file by falling back to sh
    # (measured), which is why this cannot be found by calling it; execve
    # refuses it outright with ENOEXEC, so systemd, cron and Go cannot.
    warn "$t" "installed but has no interpreter line, so it is not the shipped script (execve: ENOEXEC)"
  elif command -v "$t" >/dev/null 2>&1; then
    pass "$t" "resolves on PATH"
  else
    warn "$t" "installed but not resolvable on PATH"
  fi
done

# wp-cli is checked by RUNNING it. A truncated or corrupt phar is a file too.
if [ -f /usr/local/bin/wp ]; then
  WPV=$(wp --version --allow-root 2>/dev/null | head -1)
  if [ -n "$WPV" ]; then pass "wp-cli" "$WPV"
  else warn "wp-cli" "the file exists but does NOT run (corrupt phar)"; fi
else
  warn "wp-cli" "missing, the WordPress features will not work"
fi
COMPOSERV=$(composer --version 2>/dev/null | head -1)
if [ -n "$COMPOSERV" ]; then pass "composer" "$COMPOSERV"; else warn "composer" "missing"; fi

# ── PHP ──────────────────────────────────────────────────────────────────────
section "PHP"
# The module names are not the package names: opcache reports as "Zend OPcache"
# and pdo as "PDO", so the output is lowercased and a leading "Zend " dropped
# before each name is matched as a WHOLE line. Read once into a variable, never
# through a grep per module, because pipefail plus an early-exiting grep reports
# a working php as a failure.
PHP_LOADED=$(php -m 2>/dev/null | tr 'A-Z' 'a-z' | sed 's/^zend //')
if [ -z "$PHP_LOADED" ]; then
  warn "PHP modules" "php -m produced nothing, so this was NOT MEASURED"
else
  PHP_MISSING=""
  for m in mysqlnd mbstring bcmath intl gd soap opcache pdo xml zip; do
    [[ $'\n'"$PHP_LOADED"$'\n' == *$'\n'"$m"$'\n'* ]] || PHP_MISSING="$PHP_MISSING $m"
  done
  if [ -z "$PHP_MISSING" ]; then pass "PHP modules" "all present"
  else warn "PHP modules" "missing:$PHP_MISSING"; fi
fi

# ── Tenant isolation ─────────────────────────────────────────────────────────
section "Tenant isolation"
# Servika reaches a tenant document root through an ACL or the nginx group with
# setgid, not through an SELinux file context rule, so the thing worth measuring
# is whether nginx can actually read one. With no tenant yet there is nothing to
# measure, which is reported as such rather than as a pass.
TENANT_DOC=""
for d in /home/c_*/public_html; do
  [ -d "$d" ] && { TENANT_DOC="$d"; break; }
done
if [ -z "$TENANT_DOC" ]; then
  [ $BRIEF -eq 1 ] || printf "  ${c_y}--${c_0}   %-32s %s\n" "tenant document root" "no tenant yet, nothing to measure"
elif ! command -v runuser >/dev/null 2>&1; then
  warn "tenant document root" "runuser is missing, so this was NOT MEASURED"
elif runuser -u nginx -- test -r "$TENANT_DOC" 2>/dev/null; then
  pass "tenant document root" "nginx can read $TENANT_DOC"
else
  warn "tenant document root" "nginx CANNOT read $TENANT_DOC (servika-repair)"
fi

# ── Security and maintenance ─────────────────────────────────────────────────
section "Security and maintenance"
AV_SIGNATURES=$(ls /var/lib/clamav/*.c[vl]d 2>/dev/null | wc -l)
# Present is not the same as current. main.cvd ships with the package and stays
# untouched for months, so counting files reports a server whose freshclam has
# not run since installation as fully protected. daily.cld is rewritten several
# times a day while freshclam works, so "nothing here changed in a week" is the
# measurable form of "the updater stopped".
AV_FRESH=$(find /var/lib/clamav -maxdepth 1 \( -name '*.cvd' -o -name '*.cld' \) -mtime -7 2>/dev/null | wc -l | tr -d ' ')
if [ "$AV_SIGNATURES" -gt 0 ] 2>/dev/null; then
  if [ "${AV_FRESH:-0}" -gt 0 ] 2>/dev/null; then
    pass "ClamAV signatures" "$AV_SIGNATURES present, $AV_FRESH updated within 7 days"
  else
    warn "ClamAV signatures" "$AV_SIGNATURES present but NONE updated within 7 days, so freshclam has stopped"
  fi
else
  warn "ClamAV signatures" "none, so a scan has nothing to match against"
fi

if [ "$(findmnt -no FSTYPE / 2>/dev/null)" = "xfs" ]; then
  QUOTA_OPTIONS=$(findmnt -no OPTIONS / 2>/dev/null)
  case ",$QUOTA_OPTIONS," in
    *,usrquota,*|*,uquota,*|*,quota,*) pass "disk quota" "active" ;;
    *) warn "disk quota" "written into GRUB but NOT active, one reboot is needed" ;;
  esac
fi

# ── What the installation is made of ─────────────────────────────────────────
# Everything above asks whether the server ANSWERS. This asks whether it was
# BUILT correctly, which is a different question: the panel can be up while a
# release file never reached the disk, a directory was never created, or a
# service is active without ever having bound its port. Those only surface when
# somebody uses the feature, which means on a customer.
#
# Each group reports as a SUMMARY with only the failures listed, because silence
# cannot be told apart from a check that never ran.

section "Release files"
# A file that exists but is EMPTY or truncated is not present in any useful
# sense: a truncated frontend index is a white screen and a truncated tool is a
# step that vanishes with no error. The minimum sizes are deliberately far below
# the real ones; they catch zero and half-written, not drift.
FILE_MISSING=""; FILE_OK=0; FILE_TOTAL=0
while IFS='|' read -r fpath fkind fmin; do
  [ -z "$fpath" ] && continue
  FILE_TOTAL=$((FILE_TOTAL+1))
  if [ ! -e "$fpath" ]; then
    FILE_MISSING="$FILE_MISSING
      MISSING    $fpath"
  elif [ "$fkind" = "x" ] && [ ! -x "$fpath" ]; then
    FILE_MISSING="$FILE_MISSING
      NOT EXEC   $fpath"
  else
    fsize=$(stat -c%s "$fpath" 2>/dev/null)
    if [ -z "$fsize" ]; then
      FILE_MISSING="$FILE_MISSING
      NOT MEASURED $fpath"
    elif [ "$fsize" -lt "${fmin:-1}" ]; then
      FILE_MISSING="$FILE_MISSING
      TRUNCATED  $fpath ($fsize bytes, at least $fmin expected)"
    else
      FILE_OK=$((FILE_OK+1))
    fi
  fi
done <<EOF
$SERVIKA_BIN_PATH|x|1000000
/opt/servika/frontend-dist/index.html|f|200
/etc/servika/env|f|60
/etc/systemd/system/servika.service|f|100
/etc/nginx/conf.d/_panel.conf|f|100
/etc/nginx/conf.d/_default80.conf|f|100
/etc/nginx/conf.d/_default443.conf|f|100
/var/www/_default80/index.html|f|200
/usr/local/bin/servika-update|x|1000
/usr/local/bin/servika-restore|x|1000
/usr/local/bin/servika-repair|x|1000
/usr/local/bin/servika-verify|x|1000
EOF
if [ -z "$FILE_MISSING" ]; then
  pass "release files" "$FILE_OK/$FILE_TOTAL"
else
  crit "release files" "$FILE_OK/$FILE_TOTAL$FILE_MISSING"
fi

# The loop above measures that the environment file EXISTS and is not truncated.
# Its MODE was measured nowhere at all, and the file carries SERVIKA_JWT_SECRET,
# SERVIKA_SECRET_KEY and the database password: readable by one more account,
# every session on this panel can be forged. The loader at the top refuses to
# read it in that state and records why, which is what is reported here.
if [ ! -f "$ENV_FILE" ]; then
  : # already reported as missing above; saying it twice helps nobody
elif [ -n "$ENV_PERM_PROBLEM" ]; then
  crit "environment file exposure" "$ENV_PERM_PROBLEM; it carries the JWT secret, the encryption key and the database password"
else
  pass "environment file exposure" "$(stat -c '%a %U:%G' "$ENV_FILE" 2>/dev/null)"
fi

# The JS bundle carries a content hash in its name, so it is found by glob. Its
# absence is the white screen `index.html` alone cannot reveal.
FRONTEND_BUNDLE=""
for b in /opt/servika/frontend-dist/assets/index-*.js; do
  [ -f "$b" ] && { FRONTEND_BUNDLE="$b"; break; }
done
if [ -n "$FRONTEND_BUNDLE" ] && [ -s "$FRONTEND_BUNDLE" ]; then
  pass "frontend bundle" "$(basename "$FRONTEND_BUNDLE")"
else
  crit "frontend bundle" "assets/index-*.js is missing or empty, so the panel is a white screen"
fi

section "Directories"
DIR_MISSING=""; DIR_OK=0; DIR_TOTAL=0
while IFS='|' read -r dpath downer; do
  [ -z "$dpath" ] && continue
  DIR_TOTAL=$((DIR_TOTAL+1))
  if [ ! -d "$dpath" ]; then
    DIR_MISSING="$DIR_MISSING
      MISSING  $dpath"
  elif [ -n "$downer" ]; then
    dactual=$(stat -c%U "$dpath" 2>/dev/null)
    if [ "$dactual" != "$downer" ]; then
      DIR_MISSING="$DIR_MISSING
      OWNER    $dpath (is $dactual, $downer expected)"
    else
      DIR_OK=$((DIR_OK+1))
    fi
  else
    DIR_OK=$((DIR_OK+1))
  fi
done <<EOF
/opt/servika/bin|root
/opt/servika/frontend-dist|root
${SERVIKA_MIGR:-/opt/servika/src/migrations}|root
/opt/servika/src/scripts|root
/etc/servika|root
/var/www/_default80|
/var/www/_acme|
${SERVIKA_NGINX_CACHE_DIR:-/var/cache/nginx/servikacache}|nginx
EOF
if [ -z "$DIR_MISSING" ]; then
  pass "directories" "$DIR_OK/$DIR_TOTAL"
else
  crit "directories" "$DIR_OK/$DIR_TOTAL$DIR_MISSING"
fi

# Directories nothing creates until it is first needed. Their absence is not a
# fault and must never be reported as one.
#
# The backup root was in the CRITICAL list above and it FAILED a healthy
# installation: nothing creates it eagerly, and the scheduled backup that does
# runs at 03:30, so every measurement between the installation and that hour
# reported a working server as broken. Since this tool is a gate, the installer
# then printed "Installation NOT complete" and exited 1, and servika-update and
# servika-restore exit 1 on a critical too. A check that produces a false
# positive is worse than no check at all, and this one did real damage.
#
# The message names what is actually true on a fresh server AND on one that has
# been running for months. "It will be created on the first run" is right for
# the first and misleading for the second, where the fact worth reporting is
# that no backup has ever been written.
BACKUP_ROOT_DIR="${SERVIKA_BACKUP_ROOT:-/var/backups/servika}"
if [ -d "$BACKUP_ROOT_DIR" ]; then
  pass "backup root" "$BACKUP_ROOT_DIR"
else
  warn "backup root" "$BACKUP_ROOT_DIR does not exist, so no backup has been written yet (servika-db-backup creates it)"
fi

section "Service to port"
# "active" is not "listening". systemd calls a unit active while its process has
# not bound anything: a wrong address, a refused bind or a port already taken all
# leave it active and unreachable. Only services that are already ACTIVE are
# measured here, because a stopped one is reported in the Services section above.
if ! command -v ss >/dev/null 2>&1; then
  warn "service to port" "NOT MEASURED (ss is missing)"
else
  LISTENING=$( { ss -tlnH 2>/dev/null; ss -ulnH 2>/dev/null; } )
  PORT_MISSING=""; PORT_OK=0; PORT_TOTAL=0
  while IFS='|' read -r sunit spattern sconsequence; do
    [ -z "$sunit" ] && continue
    [ "$spattern" = ":" ] && continue   # the port could not be discovered above
    systemctl is-active --quiet "$sunit" 2>/dev/null || continue
    PORT_TOTAL=$((PORT_TOTAL+1))
    case "$LISTENING" in
      *"$spattern"*) PORT_OK=$((PORT_OK+1)) ;;
      *) PORT_MISSING="$PORT_MISSING
      $sunit is ACTIVE but nothing listens on $spattern ($sconsequence)" ;;
    esac
  done <<EOF
mariadb|:3306|the panel cannot reach its own database
servika|:${PORT_BACKEND}|nginx cannot proxy to the panel
nginx|:${PORT_EXTERNAL}|the panel is not reachable from a browser
named|:53|no hosted domain resolves
EOF
  if [ -z "$PORT_MISSING" ]; then
    pass "service to port" "$PORT_OK/$PORT_TOTAL"
  else
    crit "service to port" "$PORT_OK/$PORT_TOTAL$PORT_MISSING"
  fi
fi

section "Crash history"
# `journalctl -p err` does NOT show a Go panic: the runtime writes it to stderr,
# which systemd records at notice priority. Any alarm built on a priority filter
# misses this whole class, so the journal is searched by PATTERN instead.
if ! command -v journalctl >/dev/null 2>&1; then
  warn "panel crashes" "NOT MEASURED (journalctl is missing)"
else
  CRASHES=$(journalctl -u servika --since "24 hours ago" --no-pager 2>/dev/null \
            | grep -ciE 'panic:|SIGSEGV|SIGBUS|fatal error:|runtime error:')
  if [ -z "$CRASHES" ]; then
    warn "panel crashes" "NOT MEASURED (the journal could not be read)"
  elif [ "$CRASHES" -eq 0 ] 2>/dev/null; then
    pass "panel crashes" "none in the last 24 hours"
  else
    crit "panel crashes" "$CRASHES lines in the last 24 hours (journalctl -u servika | grep -iE 'panic|SIGSEGV|fatal')"
  fi
fi

section "Clock"
# A wrong clock is never reported as an error by anything: it silently breaks
# certificate validity, JWT lifetimes, backup timestamps and cron scheduling.
if ! command -v timedatectl >/dev/null 2>&1; then
  warn "clock synchronisation" "NOT MEASURED (timedatectl is missing)"
else
  case "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" in
    yes) pass "clock synchronisation" "synchronised" ;;
    no)  warn "clock synchronisation" "NOT synchronised, so certificate, session and backup times can drift" ;;
    *)   warn "clock synchronisation" "NOT MEASURED" ;;
  esac
fi

# ── Verdict ──────────────────────────────────────────────────────────────────
if [ $JSON -eq 1 ]; then
  # A detail carrying a quote, a backslash or a newline would produce output no
  # JSON parser accepts, and this mode exists to be parsed. A literal newline is
  # invalid inside a JSON string, so it is folded to a space rather than escaped:
  # the failure lists below are multi-line by design.
  json_string() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\t' '  '; }
  printf '{"passed":%d,"critical":%d,"warnings":%d,"failures":[' "$PASSED" "$CRITICAL" "$WARNINGS"
  first=1
  for f in ${FAILURES[@]+"${FAILURES[@]}"}; do
    [ $first -eq 0 ] && printf ','
    first=0
    level=${f%%|*}; rest=${f#*|}; check=${rest%%|*}; detail=${rest#*|}
    printf '{"level":"%s","check":"%s","detail":"%s"}' \
      "$(json_string "$level")" "$(json_string "$check")" "$(json_string "$detail")"
  done
  printf ']}\n'
  [ $CRITICAL -gt 0 ] && exit 1
  exit 0
fi

echo
if [ $CRITICAL -gt 0 ]; then
  echo -e "${c_r}${c_b}VERIFICATION FAILED${c_0}  passed: $PASSED   ${c_r}critical: $CRITICAL${c_0}   warnings: $WARNINGS"
  echo -e "  Fix the ${c_r}FAIL${c_0} lines above and measure again:  ${c_b}servika-verify${c_0}"
  exit 1
fi
if [ $WARNINGS -gt 0 ]; then
  echo -e "${c_g}${c_b}Critical checks passed${c_0}  passed: $PASSED   warnings: ${c_y}$WARNINGS${c_0}"
  echo -e "  A warning does not stop the server, it means a feature is missing (see above)."
  exit 0
fi
echo -e "${c_g}${c_b}All checks passed${c_0}  $PASSED checks"
exit 0
