#!/usr/bin/env bash
# servika-verify proves that an installation or an update actually works.
#
#   servika-verify           # full report
#   servika-verify --brief   # summary plus failures only (installer and updater)
#   servika-verify --json    # machine readable
#
# WHY IT EXISTS
#
# The installer's verification step used to be decorative. It printed the state
# of the server and then printed the success banner whatever it had found, so a
# run could report a missing tool, a stopped service and a catch-all answering
# 500 for every Host, and still finish with "installation complete". Nothing an
# operator saw there could stop anything.
#
# This tool replaces that step and is a GATE: when a critical check fails it
# exits 1 and the caller does not print the banner.
#
# DESIGN RULES
#
# 1. Measure the PRODUCTION path, not the installation step. "the chmod ran" and
#    "nginx can actually read it" are different claims; measure the second.
# 2. A check that could not be MEASURED has FAILED. Empty output is not "clean",
#    so there is no `|| echo 0` anywhere here: a curl that cannot connect reports
#    NO-CONNECTION rather than an empty string, which would compare equal to 0
#    in a numeric test and pass the check by accident.
# 3. 401 and 404 are not the same answer. 401 means the route is registered and
#    asking for identity, which is correct. 404 means the route is not there at
#    all, which means the binary or the router is broken. A check that treats
#    "not 200" as "protected" is lying.
# 4. No pipe into `grep -q`: grep closes the pipe at the first match, the command
#    above it takes SIGPIPE, and pipefail then reports the whole pipeline failed.
# 5. Every check must have a path on which it can fail. One that cannot fail is
#    not measuring anything.
# 6. A fallback that GUESSES makes a wrong measurement look like a right one.
#    Nothing here guesses a port; the panel's own binary reports them.
#
# CRITICAL means the panel does not work. WARNING means a feature is missing.
set -uo pipefail

# sudo builds PATH from scratch out of secure_path, which on AlmaLinux 10 is
# /sbin:/bin:/usr/sbin:/usr/bin and excludes /usr/local/bin, where this tool and
# its siblings live. Resolvability from PATH is one of the things measured below,
# so this has to run first or the tool would report its own environment.
case ":$PATH:" in
  *:/usr/local/bin:*) : ;;
  *) export PATH="/usr/local/sbin:/usr/local/bin:$PATH" ;;
esac

# Parse in the C locale. Under tr_TR.UTF-8 the ranges `a-z` and `A-Z` do NOT
# contain `i` or `I`, so every character-range parse is cut at the first one
# (measured: `grep -oE '[a-zA-Z0-9_]+'` answers `aud` for `audit_log`). The
# brand name SERVIKA carries an I, so this reaches the environment loader too.
export LC_ALL=C

BRIEF=0; JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --brief) BRIEF=1 ;;
    --json)  JSON=1; BRIEF=1 ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

c_g=$'\033[32m'; c_y=$'\033[33m'; c_r=$'\033[31m'; c_b=$'\033[1m'; c_0=$'\033[0m'
[ -t 1 ] || { c_g=; c_y=; c_r=; c_b=; c_0=; }

PASSED=0; CRITICAL=0; WARNINGS=0
FAILURES=()

pass() { PASSED=$((PASSED+1)); [ $BRIEF -eq 1 ] || printf "  ${c_g}OK${c_0}   %-32s %s\n" "$1" "${2:-}"; }
crit() { CRITICAL=$((CRITICAL+1)); FAILURES+=("CRITICAL|$1|${2:-}")
         [ $JSON -eq 1 ] || printf "  ${c_r}FAIL${c_0} %-32s %s\n" "$1" "${2:-}"; }
warn() { WARNINGS=$((WARNINGS+1)); FAILURES+=("WARNING|$1|${2:-}")
         [ $JSON -eq 1 ] || printf "  ${c_y}WARN${c_0} %-32s %s\n" "$1" "${2:-}"; }
section() { [ $BRIEF -eq 1 ] || printf "\n${c_b}== %s ==${c_0}\n" "$*"; }

# http_code answers with the status, or NO-CONNECTION when it could not connect.
# It must never answer with an empty string: "$code" -eq 200 style comparisons
# treat empty as 0, and a check that cannot reach the server would pass.
http_code() { # $1=url  $2=host header (optional)
  local code
  if [ -n "${2:-}" ]; then
    code=$(curl -sk -o /dev/null -w '%{http_code}' -H "Host: $2" --max-time 10 "$1" 2>/dev/null)
  else
    code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2>/dev/null)
  fi
  if [ -n "$code" ] && [ "$code" != "000" ]; then echo "$code"; else echo "NO-CONNECTION"; fi
}

# svc answers with ONE line. `systemctl is-active X || echo unknown` answers with
# two: systemctl PRINTS "inactive" on stdout and ALSO exits non-zero, so the ||
# branch runs as well and the variable becomes "inactive\nunknown". printf then
# writes the second line bare, with no check name beside it. Measured against
# real systemd: an unknown unit gave exactly that pair.
svc() {
  local state
  state=$(systemctl is-active "$1" 2>/dev/null)
  state=${state%%$'\n'*}
  if [ -n "$state" ]; then echo "$state"; else echo "unknown"; fi
}

# running_binary_state <unit> <installed path>: print a reason and answer 0 when
# the running process IS the installed binary, 1 when it provably is not, and 2
# when it could not be measured. `servika-install.sh` carries the same function
# for the same reason; the two ops scripts share no library.
#
# "the service is up" and "the binary on disk is running" are different claims.
# Measured against real systemd: after `install` replaced the binary,
# `systemctl enable --now` left MainPID unchanged and `is-active` still answered
# "active" while the OLD process kept serving.
#
# The comparison is by CONTENT, never by inode. `/proc/<pid>/exe` reports
# procfs's own device number, so `stat -c '%d:%i'` on it can never equal the
# installed file and a check built that way calls every server stale (measured:
# 97:44078762 against 1048642:63995942 for one running program).
#
# `install` gives the replacement a NEW inode, so the old one stays open in the
# running process and readlink reports it with a " (deleted)" suffix. That is the
# cheap half; the checksum catches a replacement made some other way.
running_binary_state() {
  local unit="$1" installed="$2" pid link running_hash installed_hash
  pid=$(systemctl show -p MainPID --value "$unit" 2>/dev/null)
  pid=${pid%%$'\n'*}
  if [ -z "$pid" ] || [ "$pid" = "0" ]; then
    echo "the unit reports no main process (MainPID=${pid:-empty})"; return 2
  fi
  if [ ! -r "/proc/$pid/exe" ]; then
    echo "/proc/$pid/exe could not be read"; return 2
  fi
  if [ ! -f "$installed" ]; then
    echo "the installed binary is missing ($installed)"; return 1
  fi
  link=$(readlink "/proc/$pid/exe" 2>/dev/null)
  case "$link" in
    *" (deleted)") echo "the running process holds a DELETED file ($link)"; return 1 ;;
  esac
  running_hash=$(sha256sum "/proc/$pid/exe" 2>/dev/null | awk '{print $1}')
  installed_hash=$(sha256sum "$installed" 2>/dev/null | awk '{print $1}')
  if [ -z "$running_hash" ] || [ -z "$installed_hash" ]; then
    echo "the checksums could not be taken"; return 2
  fi
  if [ "$running_hash" = "$installed_hash" ]; then
    echo "running process = installed binary"; return 0
  fi
  echo "the running process is a DIFFERENT binary (${link:-unknown})"; return 1
}

# ── The panel's own ports ─────────────────────────────────────────────────────
# Read from the binary, which reads them from the files that hold them and
# refuses rather than guessing. Nothing here falls back to a number: the panel
# can move both of its ports, and a check that connected to the old one would
# report a healthy server as broken, or a stopped one as fine.
section "Panel ports"
SERVIKA_BIN_PATH="${SERVIKA_BIN:-/opt/servika/bin/servika-server}"
PORT_BACKEND=""; PORT_EXTERNAL=""; PORT_HEALTH=""
if [ ! -x "$SERVIKA_BIN_PATH" ]; then
  crit "panel binary" "$SERVIKA_BIN_PATH is missing or not executable"
else
  if ! PORTS_OUT=$("$SERVIKA_BIN_PATH" -print-ports 2>&1); then
    crit "panel ports" "could not be read: $PORTS_OUT"
  else
    while IFS='=' read -r key value; do
      case "$key" in
        backend)    PORT_BACKEND="$value" ;;
        external)   PORT_EXTERNAL="$value" ;;
        health_url) PORT_HEALTH="$value" ;;
      esac
    done <<< "$PORTS_OUT"
    if [ -n "$PORT_BACKEND" ] && [ -n "$PORT_EXTERNAL" ]; then
      pass "panel ports" "backend $PORT_BACKEND, external $PORT_EXTERNAL"
    else
      crit "panel ports" "the binary answered but named no ports"
    fi
  fi
fi

# ── The process behind the panel ─────────────────────────────────────────────
# A panel that is up on a binary it no longer runs answers every check below
# with the OLD code, so this comes before them. It happens whenever something
# replaced the binary without restarting the service, which systemd reports as
# "active" throughout. CRITICAL because the code serving this server is not the
# code installed on it, and an unmeasurable answer is critical too, since this
# is the tool whose whole contract is to measure.
section "Running process"
BINARY_REASON=$(running_binary_state servika "$SERVIKA_BIN_PATH")
case $? in
  0) pass "running binary" "$BINARY_REASON" ;;
  1) crit "running binary" "$BINARY_REASON (systemctl restart servika)" ;;
  *) crit "running binary" "NOT MEASURED: $BINARY_REASON" ;;
esac

# ── Services ─────────────────────────────────────────────────────────────────
section "Services"
# Without these four there is no panel and no site.
for s in servika nginx mariadb php-fpm; do
  state=$(svc "$s")
  if [ "$state" = "active" ]; then pass "$s" "active"
  else crit "$s" "$state (the panel cannot work without it)"; fi
done
# The panel opens without these; a feature does not.
for s in valkey named crond postfix dovecot opendkim pure-ftpd httpd; do
  state=$(svc "$s")
  if [ "$state" = "active" ]; then pass "$s" "active"; else warn "$s" "$state"; fi
done

# ── Panel HTTP surface ───────────────────────────────────────────────────────
section "Panel HTTP surface"
if [ -z "$PORT_EXTERNAL" ] || [ -z "$PORT_BACKEND" ]; then
  # A check that could not be measured has failed. Connecting to a guessed port
  # and reporting the answer would be worse than saying so.
  crit "panel page" "NOT MEASURED (the ports are unknown)"
  crit "/healthz" "NOT MEASURED (the ports are unknown)"
  crit "API authentication" "NOT MEASURED (the ports are unknown)"
else
  code=$(http_code "https://127.0.0.1:${PORT_EXTERNAL}/")
  if [ "$code" = "200" ]; then pass "panel page" "HTTP 200 on :$PORT_EXTERNAL"
  else crit "panel page" "HTTP $code on :$PORT_EXTERNAL (200 expected)"; fi

  code=$(http_code "${PORT_HEALTH:-http://127.0.0.1:${PORT_BACKEND}/healthz}")
  if [ "$code" = "200" ]; then pass "/healthz" "HTTP 200 on :$PORT_BACKEND"
  else crit "/healthz" "HTTP $code on :$PORT_BACKEND (200 expected)"; fi

  # 401 says the route exists and is protected. 404 says the route was never
  # registered, which means the binary or the frontend is not the one this
  # release ships. Treating anything that is not 200 as "protected" would report
  # a broken router as a working guard.
  code=$(http_code "https://127.0.0.1:${PORT_EXTERNAL}/api/v1/domains")
  case "$code" in
    401) pass "API authentication" "HTTP 401 (route registered, guard working)" ;;
    404) crit "API authentication" "HTTP 404 (the route is not registered at all)" ;;
    200) crit "API authentication" "HTTP 200 (the API answered without a session)" ;;
    *)   crit "API authentication" "HTTP $code (401 expected)" ;;
  esac
fi

# ── Catch-all vhosts ─────────────────────────────────────────────────────────
section "Catch-all vhosts"
# Both catch-alls declare `try_files $uri /index.html`, so a missing document
# root page turns every request with an unmatched Host into an internal
# redirection cycle and a 500. nginx -t passes in that state, so this is the only
# thing that can find it.
code=$(http_code "http://127.0.0.1/" "unmatched-host.invalid")
case "$code" in
  5*)            crit "port 80 catch-all" "HTTP $code (unmatched hosts get an error)" ;;
  NO-CONNECTION) crit "port 80 catch-all" "could not connect" ;;
  *)             pass "port 80 catch-all" "HTTP $code" ;;
esac
code=$(http_code "https://127.0.0.1/" "unmatched-host.invalid")
case "$code" in
  5*|NO-CONNECTION) warn "port 443 catch-all" "HTTP $code" ;;
  *)                pass "port 443 catch-all" "HTTP $code" ;;
esac

# ── nginx ────────────────────────────────────────────────────────────────────
section "nginx"
if ! command -v nginx >/dev/null 2>&1; then
  # Not the same finding as an invalid configuration, and saying so matters:
  # one is a file to fix, the other is a package that was never installed.
  crit "nginx -t" "nginx is not installed, so this was NOT MEASURED"
elif nginx -t >/dev/null 2>&1; then
  pass "nginx -t" "valid"
else
  crit "nginx -t" "the configuration is INVALID, the next reload will fail"
fi

# Measure the production path: a permission bit says nothing if a parent
# directory is 0700 root:root, and fastcgi_cache then fails silently because
# nginx itself stays up.
CACHE_DIR="${SERVIKA_NGINX_CACHE_DIR:-/var/cache/nginx/servikacache}"
if [ ! -d "$CACHE_DIR" ]; then
  warn "nginx cache directory" "$CACHE_DIR does not exist"
elif ! command -v runuser >/dev/null 2>&1; then
  warn "nginx cache access" "runuser is missing, so this was NOT MEASURED"
elif runuser -u nginx -- test -r "$CACHE_DIR" 2>/dev/null; then
  pass "nginx cache access" "nginx can read it"
else
  warn "nginx cache access" "nginx CANNOT read it, fastcgi_cache is dead (servika-repair)"
fi

# ── Database ─────────────────────────────────────────────────────────────────
section "Database"
# Connect the way the PANEL connects, never as root. root over the unix socket
# always answers, so a check built on it stays green when the password in the
# environment file is wrong or the GRANT was revoked, which is precisely the
# state in which the panel cannot start. The password travels through a 0600
# defaults file and never through argv, the same way servika-install.sh proves
# the account it just created.
# db_defaults_file sets DB_DEFAULTS, DB_NAME and DB_WHO from the panel DSN, and
# answers non-zero when it cannot parse it. It ASSIGNS rather than prints: a
# command substitution would run it in a subshell, where the other two values
# never reach the caller (measured, and the empty database name then made the
# migration query fail as "not measured").
db_defaults_file() {
  local dsn="$1" rest creds netpart proto addr db user pass file
  rest=${dsn%%\?*}
  case "$rest" in *@*) ;; *) return 1 ;; esac
  creds=${rest%@*}
  netpart=${rest##*@}
  user=${creds%%:*}
  case "$creds" in *:*) pass=${creds#*:} ;; *) pass="" ;; esac
  [ -n "$user" ] || return 1
  case "$netpart" in
    *'('*')'*) proto=${netpart%%(*}; addr=${netpart#*(}; addr=${addr%%)*}; db=${netpart##*)/} ;;
    *)         proto=""; addr=""; db=${netpart##*/} ;;
  esac
  [ -n "$db" ] || return 1
  file=$(mktemp) || return 1
  chmod 600 "$file" || { rm -f "$file"; return 1; }
  {
    printf '[client]\nuser=%s\n' "$user"
    [ -n "$pass" ] && printf 'password=%s\n' "$pass"
    case "$proto" in
      unix) printf 'socket=%s\n' "$addr" ;;
      tcp)  printf 'host=%s\nport=%s\n' "${addr%:*}" "${addr##*:}" ;;
    esac
  } > "$file"
  DB_DEFAULTS="$file"; DB_NAME="$db"; DB_WHO="$user@${addr:-local}/$db"
}

DB_DSN=""; DB_NAME=""; DB_WHO=""; DB_DEFAULTS=""
if [ -r /etc/servika/env ]; then
  # A literal key, so no character range and no locale to depend on.
  DB_DSN=$(sed -n 's/^SERVIKA_DB_DSN=//p' /etc/servika/env 2>/dev/null | tail -n 1)
  DB_DSN=${DB_DSN%\"}; DB_DSN=${DB_DSN#\"}
  DB_DSN=${DB_DSN%\'}; DB_DSN=${DB_DSN#\'}
fi
if [ -z "$DB_DSN" ]; then
  crit "panel database identity" "SERVIKA_DB_DSN could not be read from /etc/servika/env"
else
  db_defaults_file "$DB_DSN" || DB_DEFAULTS=""
  [ -n "$DB_DEFAULTS" ] || crit "panel database identity" "SERVIKA_DB_DSN could not be parsed"
fi

if [ -n "$DB_DEFAULTS" ] && mysql --defaults-extra-file="$DB_DEFAULTS" -N -e 'SELECT 1' >/dev/null 2>&1; then
  pass "MariaDB connection" "the panel's own credentials answered ($DB_WHO)"
  MIGRATIONS=$(mysql --defaults-extra-file="$DB_DEFAULTS" -N -e 'SELECT COUNT(*) FROM schema_migrations;' "$DB_NAME" 2>/dev/null)
  TABLES=$(mysql --defaults-extra-file="$DB_DEFAULTS" -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME';" 2>/dev/null)
  # The expected number is the number of files on disk. `> 0` passed a server
  # that had applied one migration out of a hundred, which is the half-migrated
  # state the updater's rollback path exists to prevent.
  MIGR_DIR="${SERVIKA_MIGR:-/opt/servika/src/migrations}"
  # shellcheck disable=SC2012 # counting files, and these names are release-controlled
  MIGR_EXPECTED=$(ls "$MIGR_DIR"/*.sql 2>/dev/null | wc -l | tr -d ' ')
  # An empty answer is "could not measure", not "zero". Telling them apart is the
  # difference between reporting a broken query and reporting an empty schema.
  if [ -z "$MIGRATIONS" ]; then
    crit "applied migrations" "NOT MEASURED (schema_migrations could not be read)"
  elif [ "${MIGR_EXPECTED:-0}" -eq 0 ]; then
    warn "applied migrations" "$MIGRATIONS applied, but $MIGR_DIR holds no files to compare against"
  elif [ "$MIGRATIONS" -ge "$MIGR_EXPECTED" ] 2>/dev/null; then
    pass "applied migrations" "$MIGRATIONS/$MIGR_EXPECTED applied"
  else
    crit "applied migrations" "$MIGRATIONS/$MIGR_EXPECTED applied, the schema is HALF MIGRATED"
  fi
  if [ -z "$TABLES" ]; then
    crit "panel tables" "NOT MEASURED"
  elif [ "$TABLES" -gt 10 ] 2>/dev/null; then
    pass "panel tables" "$TABLES tables"
  else
    crit "panel tables" "$TABLES tables, the schema is incomplete"
  fi
elif [ -n "$DB_DEFAULTS" ]; then
  crit "MariaDB connection" "the panel's own credentials were REFUSED ($DB_WHO), so the panel cannot start"
fi
[ -n "$DB_DEFAULTS" ] && rm -f "$DB_DEFAULTS"

# ── Tools ────────────────────────────────────────────────────────────────────
section "Tools"
# Being on disk is not enough. sudo drops /usr/local/bin from PATH, and every
# step that reaches these tools by bare name then skips itself silently.
for t in servika-repair servika-update servika-restore servika-optimize \
         servika-redis-setup servika-ftp-setup servika-mail-setup servika-db-backup; do
  if [ ! -x "/usr/local/bin/$t" ]; then
    warn "$t" "not present in the package"
  elif command -v "$t" >/dev/null 2>&1; then
    pass "$t" "resolves on PATH"
  else
    warn "$t" "installed but not resolvable on PATH"
  fi
done

# wp-cli is checked by RUNNING it. A truncated or corrupt phar is a file too.
if [ -f /usr/local/bin/wp ]; then
  WPV=$(wp --version --allow-root 2>/dev/null | head -1)
  if [ -n "$WPV" ]; then pass "wp-cli" "$WPV"
  else warn "wp-cli" "the file exists but does NOT run (corrupt phar)"; fi
else
  warn "wp-cli" "missing, the WordPress features will not work"
fi
COMPOSERV=$(composer --version 2>/dev/null | head -1)
if [ -n "$COMPOSERV" ]; then pass "composer" "$COMPOSERV"; else warn "composer" "missing"; fi

# ── PHP ──────────────────────────────────────────────────────────────────────
section "PHP"
# The module names are not the package names: opcache reports as "Zend OPcache"
# and pdo as "PDO", so the output is lowercased and a leading "Zend " dropped
# before each name is matched as a WHOLE line. Read once into a variable, never
# through a grep per module, because pipefail plus an early-exiting grep reports
# a working php as a failure.
PHP_LOADED=$(php -m 2>/dev/null | tr 'A-Z' 'a-z' | sed 's/^zend //')
if [ -z "$PHP_LOADED" ]; then
  warn "PHP modules" "php -m produced nothing, so this was NOT MEASURED"
else
  PHP_MISSING=""
  for m in mysqlnd mbstring bcmath intl gd soap opcache pdo xml zip; do
    [[ $'\n'"$PHP_LOADED"$'\n' == *$'\n'"$m"$'\n'* ]] || PHP_MISSING="$PHP_MISSING $m"
  done
  if [ -z "$PHP_MISSING" ]; then pass "PHP modules" "all present"
  else warn "PHP modules" "missing:$PHP_MISSING"; fi
fi

# ── Tenant isolation ─────────────────────────────────────────────────────────
section "Tenant isolation"
# Servika reaches a tenant document root through an ACL or the nginx group with
# setgid, not through an SELinux file context rule, so the thing worth measuring
# is whether nginx can actually read one. With no tenant yet there is nothing to
# measure, which is reported as such rather than as a pass.
TENANT_DOC=""
for d in /home/c_*/public_html; do
  [ -d "$d" ] && { TENANT_DOC="$d"; break; }
done
if [ -z "$TENANT_DOC" ]; then
  [ $BRIEF -eq 1 ] || printf "  ${c_y}--${c_0}   %-32s %s\n" "tenant document root" "no tenant yet, nothing to measure"
elif ! command -v runuser >/dev/null 2>&1; then
  warn "tenant document root" "runuser is missing, so this was NOT MEASURED"
elif runuser -u nginx -- test -r "$TENANT_DOC" 2>/dev/null; then
  pass "tenant document root" "nginx can read $TENANT_DOC"
else
  warn "tenant document root" "nginx CANNOT read $TENANT_DOC (servika-repair)"
fi

# ── Security and maintenance ─────────────────────────────────────────────────
section "Security and maintenance"
AV_SIGNATURES=$(ls /var/lib/clamav/*.c[vl]d 2>/dev/null | wc -l)
if [ "$AV_SIGNATURES" -gt 0 ] 2>/dev/null; then
  pass "ClamAV signatures" "$AV_SIGNATURES present"
else
  warn "ClamAV signatures" "none, so a scan has nothing to match against"
fi

if [ "$(findmnt -no FSTYPE / 2>/dev/null)" = "xfs" ]; then
  QUOTA_OPTIONS=$(findmnt -no OPTIONS / 2>/dev/null)
  case ",$QUOTA_OPTIONS," in
    *,usrquota,*|*,uquota,*|*,quota,*) pass "disk quota" "active" ;;
    *) warn "disk quota" "written into GRUB but NOT active, one reboot is needed" ;;
  esac
fi

# ── Verdict ──────────────────────────────────────────────────────────────────
if [ $JSON -eq 1 ]; then
  printf '{"passed":%d,"critical":%d,"warnings":%d,"failures":[' "$PASSED" "$CRITICAL" "$WARNINGS"
  first=1
  for f in ${FAILURES[@]+"${FAILURES[@]}"}; do
    [ $first -eq 0 ] && printf ','
    first=0
    level=${f%%|*}; rest=${f#*|}; check=${rest%%|*}; detail=${rest#*|}
    printf '{"level":"%s","check":"%s","detail":"%s"}' "$level" "$check" "$detail"
  done
  printf ']}\n'
  [ $CRITICAL -gt 0 ] && exit 1
  exit 0
fi

echo
if [ $CRITICAL -gt 0 ]; then
  echo -e "${c_r}${c_b}VERIFICATION FAILED${c_0}  passed: $PASSED   ${c_r}critical: $CRITICAL${c_0}   warnings: $WARNINGS"
  echo -e "  Fix the ${c_r}FAIL${c_0} lines above and measure again:  ${c_b}servika-verify${c_0}"
  exit 1
fi
if [ $WARNINGS -gt 0 ]; then
  echo -e "${c_g}${c_b}Critical checks passed${c_0}  passed: $PASSED   warnings: ${c_y}$WARNINGS${c_0}"
  echo -e "  A warning does not stop the server, it means a feature is missing (see above)."
  exit 0
fi
echo -e "${c_g}${c_b}All checks passed${c_0}  $PASSED checks"
exit 0
