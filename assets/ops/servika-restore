#!/usr/bin/env bash
# servika-restore — Restore Servika CORE files from the canonical release.
#
# PURPOSE (different from servika-update):
#   • "restore", not "upgrade to latest" — repairs CORRUPTED core files
#     (0-byte frontend, deleted/corrupt binary, missing ops-tool) by matching
#     them to the canonical release.
#   • INTEGRITY-FIRST / FORCE: restores even when the release hash matches if
#     integrity is broken (empty/missing/not ELF). Update SKIPS on hash match.
#
#   servika-restore              # restore core from canonical (main) → restart if needed
#   servika-restore --dry-run    # diagnose only + show what would change, touch NOTHING
#   servika-restore --branch X   # different branch (default: main)
#   servika-restore --no-db-dump # skip pre-migration DB dump (emergency; CAUTION)
#   servika-restore --no-restart # repair files but do not restart the service
#
# PRESERVES (NEVER touches — does not delete or modify):
#   • /etc/servika/env           (JWT / DB / Redis secrets)
#   • MariaDB `panel` DB + ALL customer data
#   • /home/c_*                  (customer sites)
#   • /var/backups/servika/*     (existing backups — only ADDS a NEW dump for safety)
# Only writes these core paths: $BIN, $SEED, $FDIST, $MIGR (adds), $SCRIPTS, /usr/local/bin ops.
#
# SAFETY: frontend + binary deployed via ATOMIC + INTEGRITY-VERIFIED swap. A corrupt or
# truncated download NEVER touches the running file (0-byte outage prevention — same pattern
# as servika-update). Migrations are applied at service restart → FAIL-CLOSED DB dump is taken
# first; on an unhealthy start the previous binary + pre-repair DB are rolled back.
set -euo pipefail

# sudo builds PATH from scratch out of secure_path, which on AlmaLinux 10 is
# /sbin:/bin:/usr/sbin:/usr/bin and excludes /usr/local/bin, where this tool and
# its siblings live. Without this a lookup of one of them reports an installed
# tool as absent.
case ":$PATH:" in
  *:/usr/local/bin:*) : ;;
  *) export PATH="/usr/local/sbin:/usr/local/bin:$PATH" ;;
esac

# Parse in the C locale. Under tr_TR.UTF-8 the ranges `a-z` and `A-Z` do NOT
# contain `i` or `I`, so every character-range parse is cut at the first one
# (measured: `grep -oE '[a-zA-Z0-9_]+'` answers `aud` for `audit_log`). The
# brand name SERVIKA carries an I, so this reaches the environment loader too.
export LC_ALL=C

ENV_FILE=/etc/servika/env

load_servika_env() {
  [ -f "$ENV_FILE" ] || return 0
  [ "$(stat -c %u "$ENV_FILE" 2>/dev/null)" = 0 ] || { echo "insecure environment file owner" >&2; exit 1; }
  mode=$(stat -c %a "$ENV_FILE" 2>/dev/null) || { echo "could not read environment file mode" >&2; exit 1; }
  [ $((8#$mode & 077)) -eq 0 ] || { echo "insecure environment file mode" >&2; exit 1; }

  while IFS= read -r line || [ -n "$line" ]; do
    # POSIX classes, never `A-Za-z0-9`: a range is collation-ordered and under
    # tr_TR.UTF-8 it excludes `i`, which silently skipped SERVIKA_LISTEN.
    [[ "$line" =~ ^[[:space:]]*(SERVIKA_[[:alnum:]_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]%$'\r'}
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then value=${value:1:${#value}-2}; fi
    if [[ "$value" == \'*\' && "$value" == *\' ]]; then value=${value:1:${#value}-2}; fi
    if [ -z "${!key+x}" ]; then
      printf -v "$key" '%s' "$value"
      export "${key?}"
    fi
  done < "$ENV_FILE"
}

load_servika_env

# The health check URL is DERIVED from SERVIKA_LISTEN, the one setting that says
# where the backend listens. It used to be a setting of its own with the port
# written into it, and the panel can MOVE its backend port, which never touched
# that copy: this tool then health-checked a port nothing answers on and undid a
# repair that had worked. Derived, there is nothing left to keep in sync.
#
# The derivation is done here rather than by asking servika-server, because this
# tool exists precisely for a binary that cannot run.
#
# A listen address may name no host (":8080") or a wildcard, and none of those
# can be dialled, so they all collapse to loopback, where the panel answers in
# every one of them. internal/panelport.HealthURL carries the same rule.
derive_health_url() {
  local listen="${SERVIKA_LISTEN:-}" host port
  listen=${listen%\"}; listen=${listen#\"}
  listen=${listen%\'}; listen=${listen#\'}
  case "$listen" in
    *:*) ;;
    *) echo "SERVIKA_LISTEN ($listen) names no port, so the health check URL cannot be derived; set SERVIKA_HEALTH" >&2; return 1 ;;
  esac
  port=${listen##*:}
  host=${listen%:*}
  case "$port" in
    ''|*[!0-9]*) echo "SERVIKA_LISTEN ($listen) names no port, so the health check URL cannot be derived; set SERVIKA_HEALTH" >&2; return 1 ;;
  esac
  host=${host#[}; host=${host%]}
  case "$host" in
    ''|0.0.0.0|::|'*') host=127.0.0.1 ;;
  esac
  case "$host" in
    *:*) host="[$host]" ;;
  esac
  printf 'http://%s:%s/healthz\n' "$host" "$port"
}

REPO="${SERVIKA_REPO:-ServikaPanel/servika}"
BRANCH="main"; DRY=0; DODB=1; DORESTART=1; BRANCH_EXPLICIT=0

# Paths are overridable via env (for isolated testing). Production defaults apply.
PREFIX="${SERVIKA_PREFIX:-/opt/servika}"
BIN="${SERVIKA_BIN:-$PREFIX/bin/servika-server}"
SEED="${SERVIKA_SEED:-$PREFIX/bin/servika-seed-admin}"
FDIST="${SERVIKA_FDIST:-$PREFIX/frontend-dist}"
MIGR="${SERVIKA_MIGR:-$PREFIX/src/migrations}"
SCRIPTS="${SERVIKA_SCRIPTS:-$PREFIX/src/scripts}"
OPSBIN="${SERVIKA_OPSBIN:-/usr/local/bin}"
SVC="${SERVIKA_SVC:-servika}"
HEALTH="${SERVIKA_HEALTH:-}"
if [ -z "$HEALTH" ]; then
  # An empty result is left empty on purpose: validate_paths below refuses it by
  # name rather than this guessing a port and reporting a dead one as healthy.
  HEALTH=$(derive_health_url) || HEALTH=""
fi
DBBK="${SERVIKA_DBBK:-/usr/local/bin/servika-db-backup}"  # panel DB dump tool
DBDIR="${SERVIKA_DBDIR:-/var/backups/servika/db}"         # dump location
PREDUMP=""                                                  # pre-repair dump (restored on rollback)

# Detect host architecture for binary selection.
MACHINE=$(uname -m)
case "$MACHINE" in
  x86_64)  ARCH=linux_amd64 ;;
  aarch64) ARCH=linux_arm64 ;;
  *)       die "unsupported architecture: $MACHINE (expected x86_64 or aarch64)" ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --branch) BRANCH="$2"; BRANCH_EXPLICIT=1; shift ;;
    --branch=*) BRANCH="${1#*=}"; BRANCH_EXPLICIT=1 ;;
    --no-db-dump) DODB=0 ;;
    --no-restart) DORESTART=0 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

c_b="\033[1;34m"; c_g="\033[32m"; c_r="\033[31m"; c_y="\033[33m"; c_0="\033[0m"
[ -t 1 ] || { c_b=; c_g=; c_r=; c_y=; c_0=; }
ok()   { echo -e "  ${c_g}✓${c_0} $*"; }
warn() { echo -e "  ${c_y}!${c_0} $*"; }
die()  { echo -e "${c_r}✗ $*${c_0}" >&2; exit 1; }
step() { echo -e "${c_b}══ $* ══${c_0}"; }

# resolve_release_tag prints the release tag to restore from, or nothing if none
# can be determined. SERVIKA_RELEASE_TAG pins an exact release; otherwise the
# latest published GitHub release is queried. Mirrors install.sh so restore
# repairs against the same immutable, reviewed artifact the installer deploys.
resolve_release_tag() {
  local tag="${SERVIKA_RELEASE_TAG:-}"
  if [ -z "$tag" ]; then
    tag=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null \
      | grep '"tag_name"' | head -1 | cut -d'"' -f4)
  fi
  printf '%s' "$tag"
}

# verify_release_bundle <bundle> <sums_file> <bundle_name> confirms the bundle's
# sha256 matches the entry in the release SHA256SUMS. Returns non-zero on a
# missing/malformed checksum or a mismatch so callers can fall back safely.
verify_release_bundle() {
  local bundle_path="$1" sums_path="$2" bundle_name="$3" expected actual
  expected=$(awk -v name="$bundle_name" '$2 == name {print $1; exit}' "$sums_path")
  printf '%s' "$expected" | grep -Eq '^[0-9a-fA-F]{64}$' || return 1
  actual=$(sha256sum "$bundle_path" | cut -d' ' -f1)
  [ "$actual" = "$expected" ]
}

require_abs_path() {
  local name="$1"
  local value="$2"
  [ -n "$value" ] || die "$name must not be empty"
  case "$value" in
    /*) ;;
    *) die "$name must be an absolute path: $value" ;;
  esac
}

require_url() {
  local name="$1"
  local value="$2"
  case "$value" in
    http://*|https://*) ;;
    *) die "$name must be an http or https URL: $value" ;;
  esac
}

validate_paths() {
  require_abs_path SERVIKA_PREFIX "$PREFIX"
  require_abs_path SERVIKA_BIN "$BIN"
  require_abs_path SERVIKA_SEED "$SEED"
  require_abs_path SERVIKA_FDIST "$FDIST"
  require_abs_path SERVIKA_MIGR "$MIGR"
  require_abs_path SERVIKA_SCRIPTS "$SCRIPTS"
  require_abs_path SERVIKA_OPSBIN "$OPSBIN"
  require_abs_path SERVIKA_DBBK "$DBBK"
  require_abs_path SERVIKA_DBDIR "$DBDIR"
  require_url SERVIKA_HEALTH "$HEALTH"
}

validate_paths

is_elf() { head -c4 "$1" 2>/dev/null | grep -q $'\x7fELF'; }

[ "$(id -u)" = 0 ] || die "root required (sudo servika-restore)"
command -v curl >/dev/null || die "curl required"
command -v tar  >/dev/null || die "tar required"
command -v sha256sum >/dev/null || die "sha256sum required"

step "Servika core repair (github.com/$REPO)$([ $DRY = 1 ] && echo '  [DRY-RUN]')"

# ───────────────────────────────────────────────────────────────────────────
# a) Fetch the canonical release → $A (assets directory).
#    SERVIKA_ASSETS_OVERRIDE skips the download (isolated/offline test).
#    Default: the immutable tagged release bundle (same artifact as install.sh).
#    --branch opts into the mutable branch tarball; a failed tag resolution or
#    bundle download falls back to the branch tarball with a warning. A bundle
#    that fails its checksum does NOT: that is fatal, never a reason to reach for
#    a source with no checksum.
# ───────────────────────────────────────────────────────────────────────────
if [ -n "${SERVIKA_ASSETS_OVERRIDE:-}" ]; then
  A="$SERVIKA_ASSETS_OVERRIDE"
  [ -d "$A" ] || die "SERVIKA_ASSETS_OVERRIDE directory not found: $A"
  warn "TEST/OFFLINE: download skipped, local assets used ($A)"
else
  TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
  A=""
  if [ "$BRANCH_EXPLICIT" = 0 ]; then
    TAG=$(resolve_release_tag)
    if [ -n "$TAG" ]; then
      VERSION_TAG="${TAG#v}"
      BUNDLE="servika-${VERSION_TAG}-${ARCH}.tar.gz"
      BUNDLE_URL="https://github.com/$REPO/releases/download/$TAG/$BUNDLE"
      SUMS_URL="https://github.com/$REPO/releases/download/$TAG/SHA256SUMS"
      echo "  downloading release bundle ($TAG, $ARCH)…"
      # A download that does not arrive and a bundle that does not match its
      # checksum are NOT the same event, so they must not share an outcome.
      #
      # Not arriving is a network problem, and the branch tarball is a
      # reasonable answer. Not matching says the bundle is not what the release
      # published, and falling back there would let anyone able to serve a wrong
      # bundle move this script onto a source with no checksum at all by doing
      # nothing more than making the comparison fail. This is a repair path, so
      # it runs on a host that is already in trouble; installing unverified
      # binaries as root is the worst possible answer to that.
      if ! curl -fsSL --retry 3 -o "$TMP/$BUNDLE" "$BUNDLE_URL" \
         || ! curl -fsSL --retry 3 -o "$TMP/SHA256SUMS" "$SUMS_URL"; then
        warn "release bundle download failed ($BUNDLE_URL); falling back to branch '$BRANCH'"
        rm -rf "${TMP:?}/"* 2>/dev/null || true
      elif ! verify_release_bundle "$TMP/$BUNDLE" "$TMP/SHA256SUMS" "$BUNDLE"; then
        die "checksum mismatch for $BUNDLE against the $TAG release SHA256SUMS; repair cancelled. Re-run with --branch $BRANCH only if you accept an unverified source."
      elif ! tar xz -C "$TMP" -f "$TMP/$BUNDLE"; then
        # The checksum already passed, so this is a local unpack problem rather
        # than a bad artifact: the branch tarball is a fair second attempt.
        warn "the verified bundle could not be unpacked; falling back to branch '$BRANCH'"
        rm -rf "${TMP:?}/"* 2>/dev/null || true
      else
        ok "checksum verified"
        A="$TMP/assets"
      fi
    else
      warn "could not resolve a release tag; falling back to branch '$BRANCH'"
    fi
  fi
  if [ -z "$A" ]; then
    echo "  downloading…"
    curl -fsSL "https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH" | tar xz -C "$TMP" \
      || die "download failed — is the repo public and branch '$BRANCH' available?"
    SRC=$(find "$TMP" -maxdepth 1 -type d -name "*-$BRANCH" | head -1)
    [ -n "$SRC" ] || die "downloaded archive is empty or has an unexpected structure — repair cancelled"
    A="$SRC/assets"
  fi
fi
[ -d "$A" ] || die "assets/ not found ($A) — repo structure differs from expected"
NEWBIN="$A/$ARCH/servika-server"
[ -f "$NEWBIN" ] || die "$NEWBIN missing — canonical release is corrupt or incomplete, repair cancelled"

# ───────────────────────────────────────────────────────────────────────────
# b) INTEGRITY DIAGNOSIS (show first — let the operator see what is broken).
# ───────────────────────────────────────────────────────────────────────────
step "Current installation diagnosis"
BIN_BAD=0
if [ -s "$FDIST/index.html" ] && ls "$FDIST"/assets/index-*.js >/dev/null 2>&1; then
  ok "frontend-dist intact (index.html non-empty + JS bundle present)"
else
  warn "frontend-dist CORRUPT/MISSING (index.html empty or JS bundle absent) — will be repaired"
fi
if [ -f "$BIN" ] && is_elf "$BIN" && [ -x "$BIN" ]; then
  ok "server binary intact (ELF + executable)"
else
  BIN_BAD=1; warn "server binary CORRUPT/MISSING (absent / not ELF / not executable) — will be repaired"
fi
MISS_OPS=""
if [ -d "$A/ops" ]; then
  for t in "$A"/ops/*; do
    bn=$(basename "$t"); nm="${bn%.sh}"
    [ -x "$OPSBIN/$nm" ] || MISS_OPS="$MISS_OPS $nm"
  done
fi
if [ -n "$MISS_OPS" ]; then warn "missing ops-tools:$MISS_OPS — will be installed"; else ok "ops-tools complete"; fi

if [ "$DRY" = 1 ]; then
  step "DRY-RUN — would repair (applied NOTHING, touched NOTHING)"
  echo "  • $FDIST/  → atomic verified swap from canonical (always refreshed)"
  echo "  • $BIN     → $([ $BIN_BAD = 1 ] && echo 'CORRUPT: replaced with canonical binary' || echo 'synced to canonical (if different)') (+ $BIN.bak)"
  echo "  • $SEED    → synced to canonical seed-admin"
  echo "  • $MIGR/   → new .sql files ADDED (existing preserved)"
  echo "  • $OPSBIN + $SCRIPTS → ops-tools synced"
  echo "  • servika-repair --only htpasswd,clamav,frontend,signon (+mail when configured)"
  echo "  • mail templates under $PREFIX/src/mail-templates"
  echo "  • nginx and PHP-FPM panel integration files"
  echo "  • PRESERVED: /etc/servika/env · panel DB · /home/c_* · /var/backups/servika/*"
  [ $DODB = 1 ] && echo "  • pre-restart FAIL-CLOSED DB dump → $DBDIR (NOT taken in DRY-RUN)"
  [ $DORESTART = 1 ] && echo "  • systemctl restart $SVC + /healthz (binary+DB rollback on failure)"
  exit 0
fi

# ───────────────────────────────────────────────────────────────────────────
# c) frontend-dist — ATOMIC + VERIFIED swap (servika-update pattern).
#    New version extracted to a separate temp directory → index.html non-empty +
#    JS bundle VERIFIED → atomic mv. Corrupt/truncated extraction NEVER touches
#    the running frontend.
# ───────────────────────────────────────────────────────────────────────────
if [ -f "$A/frontend-dist.tar.gz" ]; then
  step "frontend-dist repair"
  FDNEW="${FDIST}.new.$$"
  rm -rf "$FDNEW"; mkdir -p "$FDNEW"
  fdist_abort() { rm -rf "$FDNEW" 2>/dev/null || true; die "$1"; }
  if ! tar xzf "$A/frontend-dist.tar.gz" -C "$FDNEW"; then
    fdist_abort "frontend-dist extraction failed — RUNNING frontend PRESERVED (untouched)"
  fi
  # integrity gate: index.html non-empty + at least one JS bundle (0-byte/truncated tarball rejected)
  if [ ! -s "$FDNEW/index.html" ] || ! ls "$FDNEW"/assets/index-*.js >/dev/null 2>&1; then
    fdist_abort "downloaded frontend-dist CORRUPT (index.html or JS bundles empty or missing) — RUNNING frontend PRESERVED"
  fi
  rm -rf "${FDIST}.old"
  [ -d "$FDIST" ] && mv "$FDIST" "${FDIST}.old"
  mkdir -p "$(dirname "$FDIST")"
  mv "$FDNEW" "$FDIST"
  sync   # reboot-safe: flush to disk to prevent delayed-allocation data loss (0-byte)
  ok "frontend-dist repaired (atomic verified swap)"
else
  warn "frontend-dist.tar.gz missing in canonical release — frontend skipped"
fi

# ───────────────────────────────────────────────────────────────────────────
# d) binary + seed — VERIFY ELF + size>1MB → .bak backup → atomic replace.
#    Do NOT overwrite the RUNNING binary with cp -f (TLS-EOF trap): install(1) is
#    an atomic rename; the running process holds the old inode until restart.
# ───────────────────────────────────────────────────────────────────────────
step "server binary repair"
is_elf "$NEWBIN" || die "downloaded binary is not a valid ELF — binary repair cancelled (existing preserved)"
# Cross-arch guard: prevent deploying an amd64 binary onto an arm64 host (or vice versa).
command -v file >/dev/null 2>&1 && file "$NEWBIN" | grep -q "$MACHINE" || die "the downloaded binary does not match the host architecture ($MACHINE) — repair cancelled (existing preserved)"
NSZ=$(stat -c%s "$NEWBIN" 2>/dev/null || echo 0)
[ "$NSZ" -gt 1048576 ] || die "downloaded binary is suspiciously small ($NSZ bytes ≤1MB) — repair cancelled (existing preserved)"
mkdir -p "$(dirname "$BIN")"
DO_BIN=1
if [ "$BIN_BAD" = 0 ] && [ -f "$BIN" ] && cmp -s "$NEWBIN" "$BIN"; then
  DO_BIN=0; ok "binary already byte-identical to canonical — unchanged"
fi
if [ "$DO_BIN" = 1 ]; then
  [ -f "$BIN" ] && cp -f "$BIN" "$BIN.bak" && ok "existing binary backed up ($BIN.bak)" || warn "no existing binary to back up (fresh install scenario)"
  install -m 0755 "$NEWBIN" "$BIN"
  ok "binary deployed from canonical (atomic)"
fi
if [ -f "$A/$ARCH/servika-seed-admin" ]; then
  if is_elf "$A/$ARCH/servika-seed-admin"; then
    [ -f "$SEED" ] && cp -f "$SEED" "$SEED.bak" 2>/dev/null || true
    install -m 0755 "$A/$ARCH/servika-seed-admin" "$SEED"
    ok "seed-admin synced"
  else
    warn "canonical seed-admin is not ELF — skipped"
  fi
fi

# ───────────────────────────────────────────────────────────────────────────
# e) ops-tools + src/scripts + migrations. Migrations are ADDED (existing preserved).
# ───────────────────────────────────────────────────────────────────────────
if [ -f "$A/migrations.tar.gz" ]; then
  mkdir -p "$MIGR"; tar xzf "$A/migrations.tar.gz" -C "$MIGR"
  ok "migrations synced ($(ls "$MIGR"/*.sql 2>/dev/null | wc -l) sql, existing preserved)"
elif [ -d "$A/migrations" ]; then
  mkdir -p "$MIGR"; cp -n "$A"/migrations/*.sql "$MIGR/" 2>/dev/null || true
  ok "migrations synced (from directory)"
fi
if [ -d "$A/ops" ]; then
  mkdir -p "$OPSBIN" "$SCRIPTS"
  for t in "$A"/ops/*; do bn=$(basename "$t"); install -m 0755 "$t" "$OPSBIN/${bn%.sh}" 2>/dev/null || true; done
  cp "$A"/ops/* "$SCRIPTS/" 2>/dev/null || true
  ok "ops-tools + src/scripts synced"
fi

# Targeted repair. This tool installs a new servika-repair a few lines above and
# never RAN it, exactly as servika-update did not, so a repair section reached
# the fleet's disk and executed only on a fresh install. On the tool an operator
# reaches for when the installation is already broken, that is the wrong half.
#
# The section list matches servika-update's, and for the same measured reasons:
# these four are the ones the running panel does NOT perform, while
# provisioner.Init repairs phpMyAdmin, the nginx cache and tenant homes at every
# start and firewall.TakeOverFirewalld masks firewalld. `domains` is excluded
# because on a host whose ACL read test fails it runs `chown -R` across a live
# document root and turns public_html 0750 into 2750. `mail` is conditional
# because without the mail setup that section prints eight "absent" warnings.
#
# There is no shared library between these tools, so each carries its own copy,
# the same way each carries its own PATH block and health-URL derivation.
REPAIR_SECTIONS="htpasswd,clamav,frontend,signon"
if [ -f /etc/postfix/mysql-virtual-domains.cf ]; then
  REPAIR_SECTIONS="$REPAIR_SECTIONS,mail"
fi
if command -v servika-repair >/dev/null 2>&1; then
  if servika-repair --quiet --only "$REPAIR_SECTIONS"; then
    ok "targeted repair ($REPAIR_SECTIONS)"
  else
    warn "the targeted repair reported an error; run: servika-repair --only $REPAIR_SECTIONS"
  fi
elif [ -x "$OPSBIN/servika-repair" ]; then
  warn "servika-repair is installed but not resolvable on PATH, so the targeted repair did not run"
else
  warn "servika-repair is absent, so the targeted repair did not run"
fi

if [ -d "$A/mail" ]; then
  MAIL_TMPL="$PREFIX/src/mail-templates"
  mkdir -p "$MAIL_TMPL"
  rm -rf "${MAIL_TMPL:?}/"*
  cp -a "$A/mail/." "$MAIL_TMPL/"
  ok "mail templates synced"
fi
if [ -f "$A/nginx/_panel.conf" ]; then
  cp "$A/nginx/_panel.conf" /etc/nginx/conf.d/_panel.conf
  ok "panel nginx vhost synced"
fi
if [ -f "$A/php-fpm/roundcube.conf" ]; then
  cp "$A/php-fpm/roundcube.conf" /etc/php-fpm.d/roundcube.conf
  mkdir -p /var/lib/roundcube/{temp,sessions}
  chown -R apache:apache /var/lib/roundcube 2>/dev/null || true
  command -v restorecon >/dev/null && restorecon -R /var/lib/roundcube >/dev/null 2>&1 || true
  ok "roundcube PHP-FPM pool synced"
fi
command -v restorecon >/dev/null && restorecon -R "$(dirname "$BIN")" "$FDIST" >/dev/null 2>&1 || true

# ───────────────────────────────────────────────────────────────────────────
# f/g) restart + healthcheck + rollback. Migrations run at restart → FAIL-CLOSED
#      DB dump first. On unhealthy start, roll back to previous binary + pre-repair DB.
# ───────────────────────────────────────────────────────────────────────────
if [ "$DORESTART" = 0 ]; then
  step "Repair complete — service not restarted (--no-restart)"
  ok "core files synced to canonical (env/DB/sites/backups preserved)"
  exit 0
fi

if [ "$DODB" = 1 ]; then
  step "Pre-restart DB backup (FAIL-CLOSED)"
  if [ -x "$DBBK" ]; then
    PREDUMP=$("$DBBK") || die "pre-repair DB backup FAILED — restart cancelled (files repaired, DB untouched)"
    [ -n "$PREDUMP" ] && [ -f "$PREDUMP" ] || die "pre-repair DB backup could not be verified — restart cancelled"
    ok "pre-repair dump: $PREDUMP ($(du -h "$PREDUMP" 2>/dev/null | cut -f1))"
  else
    die "DB backup tool missing ($DBBK) — migrations without backup refused. Emergency: use --no-db-dump (CAUTION) or --no-restart"
  fi
else
  warn "DB dump SKIPPED (--no-db-dump) — restart will apply migrations with no rollback path"
fi

step "Restarting"
systemctl restart "$SVC"
HEALTHY=0
for _i in 1 2 3 4 5 6; do
  sleep 2
  if systemctl is-active --quiet "$SVC" && curl -fsS "$HEALTH" >/dev/null 2>&1; then HEALTHY=1; break; fi
done

if [ "$HEALTHY" = 1 ]; then
  if command -v servika-mail-setup >/dev/null 2>&1; then
    servika-mail-setup >/dev/null 2>&1 && ok "mail infrastructure synchronized (Postfix+Dovecot+OpenDKIM+Roundcube)" || warn "mail-setup skipped"
  fi
  systemctl reload nginx >/dev/null 2>&1 || true
  ok "panel ACTIVE + /healthz OK"
  # An active service and a healthy /healthz say the process started, not that
  # the server works. This measures production behaviour instead, and only
  # WARNS: the repair is already applied and the rollback above is a separate
  # mechanism, so a non-zero exit here would undo nothing.
  if command -v servika-verify >/dev/null 2>&1; then
    echo
    servika-verify --brief || warn "the repair was applied but verification found a CRITICAL problem (above); details: servika-verify"
  elif [ -x /usr/local/bin/servika-verify ]; then
    warn "servika-verify is installed but not resolvable on PATH, so the repair was not verified"
  fi
  echo -e "${c_g}══ Repair complete — core restored to canonical (env/DB/sites/backups preserved) ══${c_0}"
else
  warn "post-repair start failed — rolling back to previous binary + pre-repair DB"
  [ -f "$BIN.bak" ] && install -m 0755 "$BIN.bak" "$BIN"
  [ -f "$SEED.bak" ] && install -m 0755 "$SEED.bak" "$SEED" 2>/dev/null || true
  command -v restorecon >/dev/null && restorecon "$BIN" >/dev/null 2>&1 || true
  systemctl stop "$SVC" >/dev/null 2>&1 || true
  if [ -n "$PREDUMP" ] && [ -f "$PREDUMP" ]; then
    if zcat "$PREDUMP" | mysql; then ok "DB restored to pre-repair backup ($PREDUMP)"
    else warn "DB restore FAILED — manually: zcat '$PREDUMP' | mysql"; fi
  fi
  systemctl restart "$SVC"; sleep 3
  if systemctl is-active --quiet "$SVC"; then
    die "rollback complete — panel is running the PREVIOUS version + PREVIOUS DB. Error: journalctl -u $SVC -n 40"
  else
    die "CRITICAL: panel did not start even after rollback — journalctl -u $SVC -n 40 (DB backup: $PREDUMP)"
  fi
fi
