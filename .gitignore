# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Go build outputs (local builds at repository root) ---
/servika-server
/servika-seed-admin
/server
*.exe
*.test
*.out

# --- Environment / secrets ---
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# --- Runtime data (must not be committed) ---
*.log
*.sqlite
*.db
/data/
/logs/
/backups/

# A fixture under testdata/ is source, not runtime data. The rules above are
# extension-only, so a captured log or database sample is swallowed silently and
# the test that reads it passes locally and fails in CI, where the file was
# never committed.
!**/testdata/**

# --- Release build outputs (produced by scripts/build-assets.sh and CI) ---
release/
*.tar.gz

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp
__pycache__/